<section class="sh-hero sh-container{% if section.settings.image != blank %} sh-hero--image{% if section.settings.secondary_image != blank %} sh-hero--layered{% endif %}{% endif %}">
  <div class="sh-hero__copy">
    {% if section.settings.eyebrow != blank %}<p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    {% if section.settings.text != blank %}<div class="sh-hero__text sh-rte">{{ section.settings.text }}</div>{% endif %}
    {% assign hero_link = section.settings.link | default: routes.all_products_collection_url %}
    <a class="sh-button" href="{{ hero_link }}">{% if section.settings.button_label != blank %}{{ section.settings.button_label | escape }}{% else %}{{ 'navigation.collection' | t }}{% endif %}<span aria-hidden="true">↗</span></a>
    {% if section.settings.bottom_line != blank %}<p class="sh-hero__bottom sh-eyebrow">{{ section.settings.bottom_line | escape }}</p>{% endif %}
  </div>
  {% if section.settings.image != blank %}
    <div class="sh-hero__visual">
      {% if section.settings.collection_index != blank %}<p class="sh-hero__index sh-eyebrow">{{ section.settings.collection_index | escape }}</p>{% endif %}
      <div class="sh-hero__primary">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 750, 1000, 1400, 1800', sizes: '(max-width: 700px) 100vw, 60vw' }}</div>
      {% if section.settings.secondary_image != blank %}<div class="sh-hero__secondary">{{ section.settings.secondary_image | image_url: width: 850 | image_tag: loading: 'eager', widths: '240, 480, 650, 850', sizes: '(max-width: 700px) 34vw, 21vw' }}{% if section.settings.secondary_caption != blank %}<p>{{ section.settings.secondary_caption | escape }}</p>{% endif %}</div>{% endif %}
    </div>
  {% endif %}
</section>
{% stylesheet %}
  .sh-hero{padding-block:clamp(64px,8vw,136px);position:relative;min-height:580px;display:grid;align-items:center}.sh-hero--image{grid-template-columns:minmax(0,31fr) minmax(0,60fr);gap:9%;padding-block:66px 90px;max-width:none}.sh-hero__copy{padding-block:44px;position:relative;z-index:2}.sh-hero__copy .sh-eyebrow{margin-bottom:42px;max-width:250px}.sh-hero h1{font-size:clamp(64px,7.5vw,132px);font-style:italic;line-height:.89;letter-spacing:-.065em;max-width:950px}.sh-hero--image h1{width:132%}.sh-hero__text{font-size:14px;line-height:1.7;max-width:310px;margin-block:29px}.sh-hero__visual{position:relative;align-self:stretch;margin-top:8px;min-width:0}.sh-hero__primary{height:100%;min-height:600px;background:#e7e2d8;overflow:hidden}.sh-hero__primary img{width:100%;height:100%;object-fit:cover;max-height:880px}.sh-hero__index{position:absolute;inset:auto 0 calc(100% + 14px) auto;font-size:9px;display:flex;align-items:center;gap:18px}.sh-hero__index:before{content:'';display:block;width:52px;height:1px;background:currentColor}.sh-hero__secondary{position:absolute;width:35%;left:-12%;bottom:-45px;z-index:3;margin:0;box-shadow:0 0 0 7px var(--cream);background:var(--cream)}.sh-hero__secondary img{width:100%;aspect-ratio:3/4;object-fit:cover}.sh-hero__secondary p{font-size:9px;line-height:1.4;letter-spacing:.04em;padding-top:10px}.sh-hero__bottom{margin-top:54px;margin-bottom:0!important;font-size:9px!important;opacity:.7;max-width:220px!important}
  @media(min-width:1500px){.sh-hero--image{padding-inline:max(var(--gutter),calc((100vw - 1720px)/2 + var(--gutter)))}}
  @media(max-width:1050px){.sh-hero--image{grid-template-columns:minmax(0,37fr) minmax(0,58fr);gap:5%;padding-block:50px 70px}.sh-hero h1{font-size:clamp(54px,7.3vw,100px)}.sh-hero--image h1{width:116%}.sh-hero__primary{min-height:560px}.sh-hero__secondary{left:-8%;bottom:-30px;width:38%}.sh-hero__copy .sh-eyebrow{font-size:9px}}
  @media(max-width:700px){.sh-hero{min-height:0;padding-block:26px}.sh-hero--image{grid-template-columns:1fr;gap:0;padding:0 0 44px}.sh-hero--layered{padding-bottom:77px}.sh-hero__copy{padding:50px var(--gutter) 42px}.sh-hero:not(.sh-hero--image) .sh-hero__copy{padding-inline:0}.sh-hero h1{font-size:clamp(65px,14.5vw,100px);width:100%}.sh-hero__copy .sh-eyebrow{margin-bottom:30px;max-width:none}.sh-hero__text{max-width:330px}.sh-hero__bottom{margin-top:30px;max-width:none!important}.sh-hero__visual{margin:26px var(--gutter) 0 12vw}.sh-hero__primary{min-height:0;aspect-ratio:4/5}.sh-hero__primary img{height:100%}.sh-hero__secondary{width:42%;left:-9vw;bottom:-38px;box-shadow:0 0 0 5px var(--cream)}.sh-hero__secondary p{font-size:8px;padding-top:7px}.sh-hero__index{font-size:8px}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.hero","settings":[{"type":"text","id":"eyebrow","label":"t:settings.eyebrow","default":"Sour Hours — Vestiaire 01"},{"type":"textarea","id":"heading","label":"t:settings.heading","default":"Les heures\nà soi."},{"type":"richtext","id":"text","label":"t:settings.text","default":"<p>Des volumes libres. Une touche d'insolence. Des pièces à porter à ta façon.</p>"},{"type":"text","id":"button_label","label":"t:settings.button_label","default":"Découvrir le vestiaire"},{"type":"url","id":"link","label":"t:settings.link"},{"type":"image_picker","id":"image","label":"t:settings.image"},{"type":"image_picker","id":"secondary_image","label":"t:settings.secondary_image"},{"type":"text","id":"secondary_caption","label":"t:settings.caption","default":"Une autre façon de prendre son temps."},{"type":"text","id":"collection_index","label":"t:settings.collection_index","default":"Collection 01 / Les heures à soi"},{"type":"text","id":"bottom_line","label":"t:settings.bottom_line","default":"Du matin lent aux derniers métros."}],"presets":[{"name":"t:sections.hero"}]}
{% endschema %}
