{% doc %}
  Provides shared typography, controls, spacing, and reduced-motion support.
{% enddoc %}
{% stylesheet %}
  :root{--cream:#f6f3ed;--ink:#20221f;--accent:#6d202b;--butter:#ece3a8;--line:color-mix(in srgb,var(--ink) 17%,transparent);--gutter:clamp(20px,4vw,72px);--serif:Georgia,'Times New Roman',serif;--sans:Arial,Helvetica,sans-serif}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--cream);color:var(--ink);font:15px/1.55 var(--sans)}img,svg,video{max-width:100%;height:auto;vertical-align:middle}img{display:block}a{color:inherit;text-underline-offset:4px}a:hover{text-decoration-thickness:2px}button,input,select,textarea{font:inherit;color:inherit}button,summary,select{cursor:pointer}input,select,textarea{max-width:100%;border:1px solid var(--line);background:transparent;padding:12px;border-radius:0}input[type=number]{width:86px}input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}button{border:0}button:disabled{cursor:not-allowed;opacity:.48}h1,h2,h3,p{margin:0}h1,h2,h3{line-height:1.06;font-weight:800}h1,h2{font-family:var(--sans);text-transform:uppercase}h1{font-size:clamp(44px,7vw,100px);letter-spacing:-.05em}h2{font-size:clamp(36px,5vw,72px);letter-spacing:-.04em}h3{font-size:18px}ul{padding-left:20px}.sh-container{padding-inline:var(--gutter);max-width:1720px;margin-inline:auto}.sh-section{padding-block:clamp(52px,7vw,112px)}.sh-eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;font-weight:700}.sh-muted{opacity:.7}.sh-button{display:inline-flex;justify-content:center;align-items:center;gap:18px;min-height:50px;padding:14px 25px;background:var(--ink);color:var(--cream);text-decoration:none;border:1px solid var(--ink);font-size:13px;font-weight:700}.sh-button:hover{background:var(--accent);border-color:var(--accent)}.sh-button--outline{color:var(--ink);background:transparent}.sh-button--outline:hover{color:var(--cream)}.sh-rule{border-top:1px solid var(--line)}.sh-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:36px 14px}.sh-empty{border:1px solid var(--line);padding:48px 24px;text-align:center;max-width:800px;margin:24px auto}.sh-empty p{margin-bottom:22px}.sh-rte{overflow-wrap:anywhere}.sh-rte>*+*{margin-top:16px}.sh-rte table{display:block;max-width:100%;overflow:auto}.sh-rte iframe{max-width:100%}.sh-pagination{margin-top:42px;display:flex;justify-content:center;gap:16px}.sh-pagination a,.sh-pagination .current{display:inline-block;padding:8px 14px;border:1px solid var(--line)}.sh-page-title{margin-bottom:38px}.sh-note{font-size:12px;line-height:1.6}.sh-error{color:var(--accent);padding:12px 0}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip-link{position:fixed;top:10px;left:10px;background:var(--cream);padding:12px;z-index:100;transform:translateY(-200%)}.skip-link:focus{transform:translateY(0)}.sh-wordmark{font:900 clamp(24px,2.7vw,38px)/.85 var(--sans);letter-spacing:-.075em;text-decoration:none;white-space:nowrap;text-transform:uppercase}.sh-loading{opacity:.55}.no-js .js-only{display:none}.sh-form-field{display:grid;gap:7px}.sh-form-field label{font-size:12px}.sh-form-field+ .sh-form-field{margin-top:18px}.sh-form-field input,.sh-form-field textarea{width:100%}.sh-form-field textarea{min-height:160px}.sh-form-actions{margin-top:24px}.sh-placeholder{width:100%;height:100%;color:var(--ink);opacity:.2;background:#fff}
  .sh-button--light{background:var(--cream);border-color:var(--cream);color:var(--ink)}.sh-button--light:hover{background:var(--butter);border-color:var(--butter);color:var(--ink)}.sh-showcase-note{padding:16px;background:var(--butter);font-size:12px;line-height:1.6;border:1px solid var(--line)}
  @view-transition{navigation:auto}
  @media(max-width:1000px){.sh-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:700px){.sh-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 12px}.sh-section{padding-block:52px}.sh-button{padding-inline:18px;min-height:48px}.sh-empty{padding:30px 20px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none!important}}
{% endstylesheet %}
{% javascript %}
  document.documentElement.classList.remove('no-js');
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){document.querySelectorAll('.sh-header details[open]').forEach(detail=>{detail.open=false;detail.querySelector('summary').focus()})}});
{% endjavascript %}
