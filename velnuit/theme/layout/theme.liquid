<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_cream }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% assign brand = settings.brand_name | default: shop.name %}
  <title>{{ page_title | escape }}{% if current_tags %} · {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} · {{ current_page }}{% endif %}{% unless page_title contains brand %} · {{ brand | escape }}{% endunless %}</title>
  {% if settings.showcase_mode %}<meta name="robots" content="noindex,nofollow">{% endif %}
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
  {{ content_for_header }}
  {% render 'theme-base' %}
  {{ 'velnuit.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'velnuit.js' | asset_url }}" defer></script>
  {% style %}:root{--cream:{{ settings.color_cream }};--ink:{{ settings.color_ink }};--accent:{{ settings.color_accent }};--butter:{{ settings.color_butter }};}{% endstyle %}
</head>
<body>
  <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
