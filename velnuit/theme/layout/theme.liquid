<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_cream }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% assign brand = settings.brand_name | default: shop.name %}
  {% capture seo_title %}{% if request.page_type == 'index' %}{{ brand }} · {{ settings.home_title }}{% else %}{{ page_title }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} · {{ current_page }}{% endif %}{% unless page_title contains brand %} · {{ brand }}{% endunless %}{% endif %}{% endcapture %}
  <title>{{ seo_title | strip | escape }}</title>
  {% if settings.showcase_mode %}<meta name="robots" content="noindex,nofollow">{% endif %}
  {% assign seo_description = page_description %}
  {% if request.page_type == 'index' %}{% assign seo_description = settings.home_description %}{% endif %}
  {% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ brand | escape }}">
  <meta property="og:title" content="{{ seo_title | strip | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {% if seo_description != blank %}<meta property="og:description" content="{{ seo_description | escape }}">{% endif %}
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
  {{ content_for_header }}
  {% render 'theme-base' %}
  {{ 'velnuit.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'velnuit.js' | asset_url }}" defer></script>
  {% style %}:root{--cream:{{ settings.color_cream }};--ink:{{ settings.color_ink }};--accent:{{ settings.color_accent }};--butter:{{ settings.color_butter }};}{% endstyle %}
</head>
<body>
  <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
