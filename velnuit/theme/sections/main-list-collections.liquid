<section class="sh-container sh-section"><h1 class="sh-page-title">{{ 'velnuit.capsule' | t }}</h1>{% paginate collections by 24 %}<div class="vn-collection-list">{% for collection in collections %}<article><h2><a href="{{ collection.url }}">{{ collection.title | escape }} ↗</a></h2>{% if collection.image != blank %}{{ collection.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,650,1000', sizes: '(max-width: 700px) 90vw, 45vw' }}{% endif %}</article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="sh-pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>
{% stylesheet %}.vn-collection-list{display:grid;grid-template-columns:1fr 1fr;gap:40px}.vn-collection-list h2{font-size:32px;margin-bottom:20px}.vn-collection-list img{width:100%;aspect-ratio:4/3;object-fit:cover}@media(max-width:700px){.vn-collection-list{grid-template-columns:1fr}}{% endstylesheet %}
{% schema %}{"name":"Liste des collections","settings":[]}{% endschema %}
