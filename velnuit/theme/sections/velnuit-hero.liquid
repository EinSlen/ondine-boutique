<section class="vn-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 | image_tag: widths: '600,1000,1500,2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'vn-hero__image' }}{% endif %}
  <div class="vn-hero__shade"></div>
  <div class="vn-hero__content"><p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 id="HeroTitle-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1><div class="sh-rte">{{ section.settings.text }}</div><a class="sh-button vn-button-sky" href="{{ section.settings.link | default: '#capsule' }}">{{ section.settings.button | escape }} <span aria-hidden="true">↘</span></a></div>
  {% if settings.showcase_mode and section.settings.image_is_concept %}<p class="vn-hero__caption">{{ 'velnuit.concept_image' | t }}</p>{% endif %}
</section>
{% schema %}
{"name":"Campagne VELNUIT","settings":[{"type":"image_picker","id":"image","label":"Image de campagne"},{"type":"checkbox","id":"image_is_concept","label":"Image de concept ou simulation","default":true},{"type":"text","id":"eyebrow","label":"Sous-titre","default":"COLLECTION 01 / CHOCOLAT & CIEL"},{"type":"textarea","id":"heading","label":"Titre","default":"Les nuits passent.\nLe style reste."},{"type":"richtext","id":"text","label":"Texte","default":"<p>Dentelle, fines rayures et jeux de superposition. Le chocolat rencontre le bleu ciel.</p>"},{"type":"text","id":"button","label":"Texte du bouton","default":"Découvrir la capsule"},{"type":"url","id":"link","label":"Destination du bouton"}],"presets":[{"name":"Campagne VELNUIT"}]}
{% endschema %}
