<section class="vn-story sh-container sh-section" id="esprit" aria-labelledby="StoryTitle-{{ section.id }}"><div><p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="StoryTitle-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2></div><div class="sh-rte">{{ section.settings.text }}<div class="vn-palette"><span><i style="background:#594030" aria-hidden="true"></i>{{ 'velnuit.chocolate' | t }}</span><span><i style="background:#c7dce7" aria-hidden="true"></i>{{ 'velnuit.sky' | t }}</span><span><i style="background:#733747" aria-hidden="true"></i>{{ 'velnuit.burgundy' | t }}</span></div></div></section>
{% schema %}
{"name":"L’esprit de la capsule","settings":[{"type":"text","id":"eyebrow","label":"Sous-titre","default":"VELNUIT / L’ESPRIT"},{"type":"textarea","id":"heading","label":"Titre","default":"Un peu 2000.\nBeaucoup toi."},{"type":"richtext","id":"text","label":"Texte","default":"<p>Des nuances qui se répondent, des manches qui se superposent, une touche de dentelle. Des idées de tenues pour sortir, rester ou prolonger la soirée.</p>"}],"presets":[{"name":"L’esprit de la capsule"}]}
{% endschema %}
