{% assign featured_collection = section.settings.collection %}
{% if featured_collection.products_count > 0 or settings.showcase_mode == false or request.design_mode %}
<section class="sh-container sh-section vn-featured" aria-labelledby="CollectionTitle-{{ section.id }}">
  <div class="vn-section-head"><div><p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="CollectionTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>{% if featured_collection != blank %}<a href="{{ featured_collection.url }}">{{ 'general.view_all' | t }} ↗</a>{% endif %}</div>
  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="sh-grid">{% for product in featured_collection.products limit: section.settings.count %}{% render 'product-card', product: product %}{% endfor %}</div>
  {% else %}<p class="vn-empty">{{ 'velnuit.collection_pending' | t }}</p>{% if request.design_mode %}<p class="sh-note">{{ 'general.editor_collection' | t }}</p>{% endif %}{% endif %}
</section>
{% endif %}
{% schema %}
{"name":"Collection Shopify","settings":[{"type":"text","id":"eyebrow","label":"Sous-titre","default":"LE VESTIAIRE"},{"type":"text","id":"heading","label":"Titre","default":"Les pièces."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Nombre de produits","min":4,"max":12,"step":4,"default":4}],"presets":[{"name":"Collection Shopify"}]}
{% endschema %}
