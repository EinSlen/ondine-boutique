{% if settings.showcase_mode %}
<section class="vn-supplier-piece sh-container sh-section" id="sweat" aria-labelledby="SupplierPieceTitle-{{ section.id }}">
  <div>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400,650,900,1200', sizes: '(max-width: 750px) 90vw, 45vw', loading: 'lazy', alt: section.settings.heading }}{% endif %}<p class="sh-note sh-muted">{{ 'velnuit.supplier_image' | t }}</p></div>
  <div><p class="sh-eyebrow">{{ 'velnuit.unisex' | t }}</p><h2 id="SupplierPieceTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="sh-rte">{{ section.settings.text }}</div><p class="sh-showcase-note">{{ 'velnuit.product_pending' | t }}</p><details><summary>{{ 'velnuit.size_guide' | t }}</summary><div class="sh-rte">{{ section.settings.size_guide }}</div></details><a href="{{ routes.root_url }}pages/contact">{{ 'velnuit.product_question' | t }} ↗</a></div>
</section>
{% endif %}
{% stylesheet %}.vn-supplier-piece{display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center;border-top:1px solid var(--line)}.vn-supplier-piece img{width:100%;height:auto;background:#eee9e0}.vn-supplier-piece h2{font-size:clamp(34px,4vw,60px);margin:18px 0 24px}.vn-supplier-piece .sh-rte{font-size:13px;line-height:1.8}.vn-supplier-piece .sh-showcase-note{margin:24px 0}.vn-supplier-piece details{border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:24px}.vn-supplier-piece summary{padding:18px 0;font-size:12px}.vn-supplier-piece table{width:100%;border-collapse:collapse;margin:0 0 15px}.vn-supplier-piece th,.vn-supplier-piece td{padding:8px;text-align:left;border-bottom:1px solid var(--line);font-size:11px}.vn-supplier-piece a{font-size:12px}@media(max-width:750px){.vn-supplier-piece{grid-template-columns:1fr;gap:28px}}{% endstylesheet %}
{% schema %}
{"name":"Pièce fournisseur","settings":[{"type":"image_picker","id":"image","label":"Photo fournisseur"},{"type":"text","id":"heading","label":"Nom de la pièce"},{"type":"richtext","id":"text","label":"Description vérifiée"},{"type":"html","id":"size_guide","label":"Guide des tailles fournisseur"}],"presets":[{"name":"Pièce fournisseur"}]}
{% endschema %}
