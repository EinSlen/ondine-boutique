<section class="main-cart"><p class="kicker">Your selection</p><h1 class="page-title">Bag / {{ cart.item_count }}</h1>{% if cart.item_count > 0 %}{% form 'cart', cart %}<table class="cart-table"><thead><tr><th>Product</th><th>Size</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<br>{{ item.product.title }}</a></td><td>{{ item.variant.title }}</td><td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><p class="cart-total">{{ cart.total_price | money }}</p><button class="button" type="submit" name="update">Update</button><button class="button button-dark" type="submit" name="checkout">Checkout</button>{% endform %}{% else %}<p class="empty-cart">Your bag is offline.</p><a class="button" href="{{ routes.all_products_collection_url }}">View the drop</a>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
