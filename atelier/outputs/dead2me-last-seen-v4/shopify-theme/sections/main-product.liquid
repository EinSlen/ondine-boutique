<section class="main-product">
  <div class="product-gallery">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '700, 1000, 1400, 1800', alt: product.title }}{% else %}<img src="{{ 'product-last-seen-hoodie.svg' | asset_url }}" width="1200" height="1500" alt="{{ product.title | escape }}">{% endif %}</div>
  <div class="product-details"><p class="kicker">DROP 001 / LAST SEEN</p><h1>{{ product.title }}</h1><p class="product-price">{{ product.price | money }}</p><div class="product-description">{{ product.description }}</div>
    {% form 'product', product, class: 'product-form', data-product-form: '' %}<label for="Variant-{{ section.id }}">Size</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" data-title="{{ variant.title | escape }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><button class="button button-dark" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}
    <p class="product-note">Shipping and returns shown at checkout.</p>
  </div>
</section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
