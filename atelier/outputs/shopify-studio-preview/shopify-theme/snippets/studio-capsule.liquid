{% doc %}
  Renders the development capsule with accessible product concept dialogs.
  @param blocks - List of merchant-configured concept blocks.
  @param {string} section_id - Unique parent section identifier.
{% enddoc %}
<section class="capsule sh-container" id="vestiaire" aria-labelledby="CapsuleTitle-{{ section_id }}">
  <div class="capsule-heading"><div><p class="sh-eyebrow">{{ 'capsule.eyebrow' | t }}</p><h2 id="CapsuleTitle-{{ section_id }}">{{ 'capsule.heading' | t }}</h2></div><p>{{ 'capsule.intro' | t }}</p></div>
  <div class="capsule-grid">
    {% for block in blocks %}
      <article class="capsule-card" {{ block.shopify_attributes }}>
        {% assign capsule_dialog_id = 'CapsuleDialog-' | append: section_id | append: '-' | append: block.id %}
        {% if block.settings.image != blank %}
          <a href="{{ block.settings.image | image_url: width: 1600 }}" class="capsule-card__image" data-capsule-open="{{ capsule_dialog_id }}" aria-haspopup="dialog" aria-controls="{{ capsule_dialog_id }}" aria-label="{{ 'capsule.open' | t: title: block.settings.title | escape }}">
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 650, 900', sizes: '(max-width: 650px) 50vw, 25vw' }}
            <span class="capsule-card__badge">{{ 'showcase.concept' | t }}</span><span class="capsule-card__plus" aria-hidden="true">↗</span>
          </a>
        {% endif %}
        <p class="capsule-card__category">{{ block.settings.category | escape }}</p><h3>{{ block.settings.title | escape }}</h3><p class="capsule-card__color">{{ block.settings.color | escape }}</p>
        <dialog class="capsule-dialog" id="{{ capsule_dialog_id }}" aria-labelledby="{{ capsule_dialog_id }}-title">
          <button type="button" class="capsule-dialog__close" data-capsule-close aria-label="{{ 'capsule.close' | t }}">×</button>
          <div class="capsule-dialog__grid"><div class="capsule-dialog__image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 750, 1100, 1400', sizes: '(max-width: 750px) 95vw, 55vw' }}{% endif %}</div><div class="capsule-dialog__copy"><p class="sh-eyebrow">{{ block.settings.category | escape }}</p><h2 id="{{ capsule_dialog_id }}-title">{{ block.settings.title | escape }}</h2><p class="capsule-card__color">{{ block.settings.color | escape }}</p><div class="sh-rte">{{ block.settings.description }}</div><p class="capsule-support">{{ 'capsule.support' | t }}<strong>{{ block.settings.support | escape }}</strong></p><p class="sh-showcase-note">{{ 'capsule.disclaimer' | t }}</p>{% if settings.showcase_mode and block.settings.supplier_url != blank %}<a class="capsule-source" href="{{ block.settings.supplier_url }}" target="_blank" rel="noopener noreferrer">{{ 'capsule.supplier' | t }} ↗</a>{% endif %}</div></div>
        </dialog>
        <noscript><details><summary>{{ 'capsule.details' | t }}</summary><div class="sh-rte">{{ block.settings.description }}</div><p>{{ block.settings.support | escape }}</p><p>{{ 'capsule.disclaimer' | t }}</p></details></noscript>
      </article>
    {% endfor %}
  </div>
  <p class="capsule-footnote">{{ 'capsule.footer' | t }}</p>
</section>
{% stylesheet %}
 .capsule{padding-block:70px 80px}.capsule-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:35px}.capsule-heading h2{font-size:clamp(36px,4vw,66px);text-transform:none;letter-spacing:-.06em;margin-top:16px}.capsule-heading>p{max-width:38ch;font-size:12px;line-height:1.8}.capsule-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.capsule-card{min-width:0}.capsule-card__image{position:relative;display:block;overflow:hidden;background:#e7e4de;aspect-ratio:1}.capsule-card__image>img{width:100%;height:100%;object-fit:contain;transition:transform .25s}.capsule-card__image:hover>img{transform:scale(1.025)}.capsule-card__badge{position:absolute;top:10px;left:10px;background:var(--cream);padding:4px 7px;font-size:9px}.capsule-card__plus{position:absolute;bottom:10px;right:10px;background:var(--cream);width:28px;height:28px;display:grid;place-items:center;border-radius:50%;font-size:14px}.capsule-card__category{font-size:9px;letter-spacing:.08em;text-transform:uppercase;margin-top:17px;opacity:.65}.capsule-card h3{font-size:17px;margin-top:7px;line-height:1.2;letter-spacing:-.025em}.capsule-card__color{font-size:11px;opacity:.7;margin-top:6px}.capsule-footnote{font-size:10px;opacity:.7;margin-top:24px;max-width:80ch;line-height:1.8}.capsule-dialog{padding:0;border:0;width:min(1100px,95vw);max-width:95vw;max-height:90dvh;overflow:auto;background:var(--cream);color:var(--ink)}.capsule-dialog::backdrop{background:#171710aa;backdrop-filter:blur(4px)}.capsule-dialog__close{position:sticky;top:14px;float:right;margin:14px 14px -58px 0;z-index:2;width:44px;height:44px;display:grid;place-items:center;background:var(--cream);color:var(--ink);border:1px solid var(--line);border-radius:50%;font-size:29px}.capsule-dialog__grid{display:grid;grid-template-columns:1.05fr 1fr;align-items:start;clear:none}.capsule-dialog__image{background:#e7e4de}.capsule-dialog__image>img{width:100%;height:auto;aspect-ratio:1;object-fit:contain}.capsule-dialog__copy{padding:55px 35px 35px}.capsule-dialog__copy h2{font-size:clamp(32px,4vw,56px);text-transform:none;letter-spacing:-.045em;margin:18px 0 12px}.capsule-dialog__copy .sh-rte{font-size:13px;line-height:1.75;margin-top:24px}.capsule-support{margin:24px 0;font-size:10px;display:grid;gap:4px}.capsule-support strong{font-size:12px}.capsule-dialog__copy .sh-showcase-note{font-size:11px}.capsule-source{display:inline-flex;align-items:center;min-height:44px;margin-top:14px;font-size:11px}body:has(.capsule-dialog[open]){overflow:hidden}.capsule-dialog:focus-visible{outline:2px solid var(--accent)}
 @media(max-width:850px){.capsule-grid{gap:12px}.capsule-heading{align-items:start;flex-direction:column;gap:20px}.capsule-heading>p{max-width:55ch}}@media(max-width:750px){.capsule-dialog__grid{grid-template-columns:1fr}.capsule-dialog__copy{padding:30px 24px}.capsule-dialog{max-height:92dvh}.capsule-dialog__close{top:10px}.capsule-dialog__image>img{max-height:60dvh}}@media(max-width:650px){.capsule{padding-block:45px}.capsule-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 12px}.capsule-heading{margin-bottom:25px}.capsule-card h3{font-size:15px}.capsule-card__badge{font-size:8px;top:7px;left:7px}.capsule-card__category{font-size:8px}.capsule-card__color{font-size:10px}}
{% endstylesheet %}
{% javascript %}
 document.addEventListener('click',event=>{const opener=event.target.closest('[data-capsule-open]');if(opener){const dialog=document.getElementById(opener.dataset.capsuleOpen);if(dialog&&typeof dialog.showModal==='function'){event.preventDefault();dialog.showModal();dialog.querySelector('[data-capsule-close]').focus();}}const closer=event.target.closest('[data-capsule-close]');if(closer)closer.closest('dialog').close();const dialog=event.target;if(dialog.matches('.capsule-dialog')){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
{% endjavascript %}
