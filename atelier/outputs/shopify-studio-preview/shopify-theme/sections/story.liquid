<section id="story" class="sh-story">
  <div class="sh-story__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 750, 1100, 1600', sizes: '(max-width: 700px) 100vw, 50vw' }}{% else %}<div class="sh-story__empty" aria-hidden="true">EVERYDAY.<br>OFF SCRIPT.</div>{% endif %}</div>
  <div class="sh-story__copy"><p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><div class="sh-rte">{{ section.settings.text }}</div>{% assign story_link = section.settings.link | default: routes.all_products_collection_url %}<a class="sh-button sh-button--outline" href="{{ story_link }}">{{ section.settings.button_label | escape }} ↗</a></div>
</section>
{% stylesheet %}
  .sh-story{display:grid;grid-template-columns:1fr 1fr;background:var(--butter);border-block:1px solid var(--line)}.sh-story__image{min-width:0;min-height:480px;background:#d4d0c6}.sh-story__image>img{width:100%;height:100%;object-fit:cover}.sh-story__empty{height:100%;display:flex;align-items:center;padding:var(--gutter);font-size:clamp(36px,5.6vw,86px);line-height:.95;font-weight:900;letter-spacing:-.07em;color:var(--accent)}.sh-story__copy{padding:clamp(38px,6vw,90px);align-self:center}.sh-story__copy .sh-eyebrow{margin-bottom:30px}.sh-story__copy h2{font-size:clamp(36px,4.2vw,66px)}.sh-story__copy .sh-rte{max-width:42ch;margin-top:26px;font-size:13px;line-height:1.8}.sh-story__copy .sh-button{margin-top:28px}
  @media(max-width:700px){.sh-story{grid-template-columns:1fr}.sh-story__image{min-height:0;aspect-ratio:4/3}.sh-story__copy{padding:40px var(--gutter)}.sh-story__empty{font-size:13vw}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.story","settings":[{"type":"text","id":"eyebrow","label":"t:settings.eyebrow","default":"L’IDÉE SIDE HABIT"},{"type":"textarea","id":"heading","label":"t:settings.heading","default":"LES BONNES\nMAUVAISES HABITUDES."},{"type":"richtext","id":"text","label":"t:settings.text","default":"<p>Reprendre le même chemin. S’arrêter au même endroit. Porter les pièces qui finissent par faire partie de toi.</p><p>SIDE HABIT imagine un vestiaire quotidien qui garde un pas de côté : un volume, une ligne, une couleur inattendue.</p>"},{"type":"image_picker","id":"image","label":"t:settings.image"},{"type":"url","id":"link","label":"t:settings.link"},{"type":"text","id":"button_label","label":"t:settings.button_label","default":"Tout le vestiaire"}],"presets":[{"name":"t:sections.story"}]}
{% endschema %}
