<section class="sh-search sh-container sh-section">
  <h1 class="sh-page-title">{{ 'search.title' | t }}</h1>
  <form class="sh-search__form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'search.label' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" required><input type="hidden" name="type" value="product"><button class="sh-button" type="submit">{{ 'navigation.search' | t }} ↗</button></form>
  {% if search.performed %}
    {% paginate search.results by 24 %}
      <p class="sh-search__count sh-note">{{ 'search.count' | t: count: search.results_count, terms: search.terms | escape }}</p>
      {% if search.results_count > 0 %}<div class="sh-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% else %}<article><h3><a href="{{ result.url }}">{{ result.title | escape }}</a></h3></article>{% endif %}{% endfor %}</div>{% else %}<div class="sh-empty"><p>{{ 'search.empty' | t }}</p></div>{% endif %}
      {% if paginate.pages > 1 %}<nav class="sh-pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% stylesheet %}
  .sh-search__form{display:flex;gap:12px;max-width:760px}.sh-search__form input[type=search]{flex:1;min-width:0}.sh-search__count{margin-block:32px}
  @media(max-width:500px){.sh-search__form{flex-direction:column}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.search","settings":[]}
{% endschema %}
