{% if section.settings.show_masthead and section.settings.masthead != blank %}<div class="sh-masthead sh-container" aria-hidden="true"><span>{{ section.settings.masthead | escape }}</span><div class="sh-masthead__meta"><span>{{ section.settings.eyebrow | escape }}</span><span>{{ section.settings.collection_index | escape }}</span><span>{{ section.settings.bottom_line | escape }}</span></div></div>{% endif %}
<section class="sh-hero sh-container{% if section.settings.image != blank %} sh-hero--image sh-hero--{{ section.settings.composition }}{% if section.settings.secondary_image != blank %} sh-hero--layered{% endif %}{% endif %}">
  <div class="sh-hero__copy">
    {% if section.settings.eyebrow != blank %}<p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    {% if section.settings.text != blank %}<div class="sh-hero__text sh-rte">{{ section.settings.text }}</div>{% endif %}
    {% assign hero_link = section.settings.link | default: routes.all_products_collection_url %}
    <a class="sh-button" href="{{ hero_link }}">{% if section.settings.button_label != blank %}{{ section.settings.button_label | escape }}{% else %}{{ 'navigation.collection' | t }}{% endif %}<span aria-hidden="true">↗</span></a>
    {% if section.settings.bottom_line != blank %}<p class="sh-hero__bottom sh-eyebrow">{{ section.settings.bottom_line | escape }}</p>{% endif %}
  </div>
  {% if section.settings.image != blank %}
    <div class="sh-hero__visual">
      {% if section.settings.collection_index != blank %}<p class="sh-hero__index sh-eyebrow">{{ section.settings.collection_index | escape }}</p>{% endif %}
      <div class="sh-hero__primary">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 750, 1000, 1400, 1800', sizes: '(max-width: 700px) 100vw, 60vw' }}</div>
      {% if section.settings.secondary_image != blank %}<div class="sh-hero__secondary">{{ section.settings.secondary_image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '320, 480, 750, 1000', sizes: '(max-width: 700px) 100vw, 35vw' }}<div class="sh-hero__secondary-copy">{% if section.settings.secondary_caption != blank %}<p>{{ section.settings.secondary_caption | escape }}</p>{% endif %}{% if section.settings.secondary_link != blank %}<a href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_link_label | escape }} ↗</a>{% endif %}</div></div>{% endif %}
    </div>
  {% endif %}
</section>
{% stylesheet %}
  .sh-masthead{padding-top:22px;padding-bottom:16px;overflow:hidden}.sh-masthead>span{display:block;text-align:center;font:italic 700 clamp(76px,19vw,330px)/.82 var(--serif);letter-spacing:-.065em;white-space:nowrap}.sh-masthead__meta{display:flex;justify-content:space-between;gap:18px;border-top:1px solid var(--ink);padding-top:10px;margin-top:28px;font-size:8px;letter-spacing:.1em;text-transform:uppercase}.sh-masthead__meta>span{max-width:35%}
  .sh-hero{padding-block:clamp(64px,8vw,136px);position:relative;min-height:580px;display:grid;align-items:center}.sh-hero--image{grid-template-columns:minmax(0,31fr) minmax(0,60fr);gap:9%;padding-block:66px 90px;max-width:none}.sh-hero__copy{padding-block:44px;position:relative;z-index:2}.sh-hero__copy .sh-eyebrow{margin-bottom:42px;max-width:250px}.sh-hero h1{font-size:clamp(64px,7.5vw,132px);font-style:italic;line-height:.89;letter-spacing:-.065em;max-width:950px}.sh-hero--image h1{width:132%}.sh-hero__text{font-size:14px;line-height:1.7;max-width:310px;margin-block:29px}.sh-hero__visual{position:relative;align-self:stretch;margin-top:8px;min-width:0}.sh-hero__primary{height:100%;min-height:600px;background:#e7e2d8;overflow:hidden}.sh-hero__primary img{width:100%;height:100%;object-fit:cover;max-height:880px}.sh-hero__index{position:absolute;inset:auto 0 calc(100% + 14px) auto;font-size:9px;display:flex;align-items:center;gap:18px}.sh-hero__index:before{content:'';display:block;width:52px;height:1px;background:currentColor}.sh-hero__secondary{position:absolute;width:35%;left:-12%;bottom:-45px;z-index:3;margin:0;box-shadow:0 0 0 7px var(--cream);background:var(--cream)}.sh-hero__secondary img{width:100%;aspect-ratio:3/4;object-fit:cover}.sh-hero__secondary p{font-size:9px;line-height:1.4;letter-spacing:.04em;padding-top:10px}.sh-hero__bottom{margin-top:54px;margin-bottom:0!important;font-size:9px!important;opacity:.7;max-width:220px!important}
  @media(min-width:1500px){.sh-hero--image{padding-inline:max(var(--gutter),calc((100vw - 1720px)/2 + var(--gutter)))}}
  @media(max-width:1050px){.sh-hero--image{grid-template-columns:minmax(0,37fr) minmax(0,58fr);gap:5%;padding-block:50px 70px}.sh-hero h1{font-size:clamp(54px,7.3vw,100px)}.sh-hero--image h1{width:116%}.sh-hero__primary{min-height:560px}.sh-hero__secondary{left:-8%;bottom:-30px;width:38%}.sh-hero__copy .sh-eyebrow{font-size:9px}}
  @media(max-width:700px){.sh-hero{min-height:0;padding-block:26px}.sh-hero--image{grid-template-columns:1fr;gap:0;padding:0 0 44px}.sh-hero--layered{padding-bottom:77px}.sh-hero__copy{padding:50px var(--gutter) 42px}.sh-hero:not(.sh-hero--image) .sh-hero__copy{padding-inline:0}.sh-hero h1{font-size:clamp(65px,14.5vw,100px);width:100%}.sh-hero__copy .sh-eyebrow{margin-bottom:30px;max-width:none}.sh-hero__text{max-width:330px}.sh-hero__bottom{margin-top:30px;max-width:none!important}.sh-hero__visual{margin:26px var(--gutter) 0 12vw}.sh-hero__primary{min-height:0;aspect-ratio:4/5}.sh-hero__primary img{height:100%}.sh-hero__secondary{width:42%;left:-9vw;bottom:-38px;box-shadow:0 0 0 5px var(--cream)}.sh-hero__secondary p{font-size:8px;padding-top:7px}.sh-hero__index{font-size:8px}}
  .sh-hero__secondary-copy>a{display:inline-block;font-size:10px;margin-top:9px}.sh-hero--split{display:block;margin-inline:14px;padding:0;min-height:0;width:calc(100% - 28px);max-width:none}.sh-hero--split .sh-hero__visual{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(0,1fr);gap:5px;height:47vw;min-height:580px;max-height:800px;margin:0}.sh-hero--split:not(.sh-hero--layered) .sh-hero__visual{grid-template-columns:1fr}.sh-hero--split .sh-hero__primary{height:100%;min-height:0;aspect-ratio:auto;min-width:0}.sh-hero--split .sh-hero__primary img{object-position:68% center}.sh-hero--split .sh-hero__secondary{position:relative;inset:auto;width:100%;min-width:0;height:100%;box-shadow:none;overflow:hidden}.sh-hero--split .sh-hero__secondary>img{height:100%;aspect-ratio:auto;object-position:center 45%}.sh-hero--split .sh-hero__secondary:after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,#27151acc);pointer-events:none}.sh-hero--split .sh-hero__secondary-copy{position:absolute;left:8%;right:8%;bottom:6%;z-index:1;color:#fff}.sh-hero--split .sh-hero__secondary-copy>p{padding:0;font:italic clamp(30px,3.3vw,55px)/.98 var(--serif);letter-spacing:-.045em;max-width:12ch}.sh-hero--split .sh-hero__secondary-copy>a{margin-top:24px}.sh-hero--split .sh-hero__copy{position:absolute;left:3.3%;top:13%;padding:0;width:26%;min-width:0;z-index:3}.sh-hero--split .sh-hero__copy>.sh-eyebrow{font-size:8px;margin-bottom:25px;max-width:23ch}.sh-hero--split h1{font-size:clamp(45px,4.8vw,80px);width:100%}.sh-hero--split .sh-hero__text{font-size:12px;margin-block:22px;max-width:25ch}.sh-hero--split .sh-hero__copy .sh-button{font-size:11px;min-height:44px;padding:10px 16px}.sh-hero--split .sh-hero__bottom{display:none}.sh-hero--split .sh-hero__index{inset:auto auto 18px 22px;z-index:2;background:#f3efe7d9;padding:4px 7px;font-size:8px}.sh-hero--split .sh-hero__index:before{display:none}
  @media(max-width:1000px){.sh-hero--split .sh-hero__visual{height:60vw;min-height:500px}.sh-hero--split .sh-hero__copy{top:12%;width:28%}.sh-hero--split h1{font-size:50px}.sh-hero--split .sh-hero__text{font-size:11px;max-width:22ch}.sh-hero--split .sh-hero__copy .sh-button{font-size:10px;gap:9px;padding-inline:12px}}
  @media(max-width:700px){.sh-masthead{padding-top:18px;padding-bottom:12px}.sh-masthead>span{font-size:18.5vw;line-height:1}.sh-masthead__meta{margin-top:8px;font-size:6px;gap:14px}.sh-masthead__meta>span{max-width:48%}.sh-masthead__meta>span:nth-child(2){display:none}.sh-hero--split{margin-inline:7px;width:calc(100% - 14px);padding:0}.sh-hero--split .sh-hero__visual{grid-template-columns:1fr;height:auto;max-height:none;min-height:0}.sh-hero--split .sh-hero__primary{height:460px}.sh-hero--split .sh-hero__primary img{object-position:64% center}.sh-hero--split .sh-hero__secondary{height:300px}.sh-hero--split .sh-hero__secondary>img{object-position:center 33%}.sh-hero--split .sh-hero__secondary:after{inset:0;background:linear-gradient(90deg,#24131799,transparent 75%)}.sh-hero--split .sh-hero__secondary-copy{left:6%;bottom:9%}.sh-hero--split .sh-hero__secondary-copy>p{font-size:35px}.sh-hero--split .sh-hero__copy{left:6%;top:30px;width:43%}.sh-hero--split h1{font-size:48px}.sh-hero--split .sh-hero__copy>.sh-eyebrow{font-size:8px;margin-bottom:20px}.sh-hero--split .sh-hero__copy .sh-button{font-size:9px;line-height:1.35;gap:8px;padding:8px 10px}.sh-hero--split .sh-hero__text{display:none}.sh-hero--split .sh-hero__copy .sh-button{margin-top:24px}.sh-hero--split .sh-hero__index{top:425px;bottom:auto;left:12px;font-size:6px}}
  @media(max-width:1000px){.sh-hero--split .sh-hero__primary{position:relative}.sh-hero--split .sh-hero__primary:after{content:'';position:absolute;inset:30% 0 0;background:linear-gradient(transparent,#15232da8);pointer-events:none}.sh-hero--split .sh-hero__copy{top:auto;bottom:62px;width:48%;color:white}.sh-hero--split .sh-hero__text{display:none}.sh-hero--split .sh-hero__copy>.sh-eyebrow{max-width:none}}
  @media(max-width:700px){.sh-hero--split .sh-hero__copy{top:205px;bottom:auto;width:88%}.sh-hero--split .sh-hero__secondary>img{object-position:center 16%}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.hero","settings":[{"type":"checkbox","id":"show_masthead","label":"t:settings.show_masthead","default":true},{"type":"text","id":"masthead","label":"t:settings.wordmark","default":"mauvais pli"},{"type":"select","id":"composition","label":"t:settings.composition","options":[{"value":"split","label":"t:settings.split"},{"value":"inset","label":"t:settings.inset"}],"default":"split"},{"type":"text","id":"eyebrow","label":"t:settings.eyebrow","default":"Mauvais Pli — Vestiaire 01"},{"type":"textarea","id":"heading","label":"t:settings.heading","default":"Le détail\nchange tout."},{"type":"richtext","id":"text","label":"t:settings.text","default":"<p>Un relief, une rayure, un motif. Des formes simples, juste assez décalées pour changer l'allure.</p>"},{"type":"text","id":"button_label","label":"t:settings.button_label","default":"Découvrir le vestiaire"},{"type":"url","id":"link","label":"t:settings.link"},{"type":"image_picker","id":"image","label":"t:settings.image"},{"type":"image_picker","id":"secondary_image","label":"t:settings.secondary_image"},{"type":"text","id":"secondary_caption","label":"t:settings.caption","default":"Une touche qui change l'allure."},{"type":"url","id":"secondary_link","label":"t:settings.secondary_link"},{"type":"text","id":"secondary_link_label","label":"t:settings.secondary_link_label","default":"Double Cherry"},{"type":"text","id":"collection_index","label":"t:settings.collection_index","default":"Vestiaire 01 / Le détail change tout"},{"type":"text","id":"bottom_line","label":"t:settings.bottom_line","default":"À porter à ta façon."}],"presets":[{"name":"t:sections.hero"}]}
{% endschema %}
