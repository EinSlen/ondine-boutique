{% doc %}
  Renders a linked product card using the product's published image and price.
  @param {product} product - The product displayed in the card.
{% enddoc %}
{% liquid
  assign card_image_alt = product.featured_image.alt | default: product.title
  assign card_price = product.price | money
%}
<article class="sh-card">
  <a class="sh-card__link" href="{{ product.url }}">
    <div class="sh-card__image">
      {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(max-width: 700px) 46vw, (max-width: 1000px) 30vw, 23vw', alt: card_image_alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'sh-placeholder' }}{% endif %}
      {% unless product.available %}<span class="sh-card__availability">{{ 'product.sold_out' | t }}</span>{% endunless %}
    </div>
    <div class="sh-card__info"><h3>{{ product.title | escape }}</h3><span>{% if product.price_varies %}{{ 'product.from_price' | t: price: card_price }}{% else %}{{ card_price }}{% endif %}</span></div>
    {% if product.type != blank %}<p class="sh-card__type">{{ product.type | escape }}</p>{% endif %}
  </a>
</article>
{% stylesheet %}
  .sh-card{min-width:0}.sh-card__link{text-decoration:none}.sh-card__image{aspect-ratio:4/5;background:#fff;position:relative;overflow:hidden}.sh-card__image img{width:100%;height:100%;object-fit:contain;transition:transform .35s ease}.sh-card__link:hover .sh-card__image img{transform:scale(1.025)}.sh-card__info{display:flex;justify-content:space-between;gap:14px;align-items:baseline;margin-top:16px}.sh-card__info h3{font-size:13px;font-weight:700;line-height:1.35}.sh-card__info>span{font-size:12px;white-space:nowrap}.sh-card__type{margin-top:5px;font-size:11px;opacity:.6}.sh-card__availability{position:absolute;left:12px;bottom:12px;background:var(--cream);padding:5px 9px;font-size:10px}.sh-card__image .sh-placeholder{padding:12%}
  @media(max-width:700px){.sh-card__info{display:block;margin-top:12px}.sh-card__info>span{display:block;margin-top:4px}.sh-card__info h3{font-size:12px}}
{% endstylesheet %}
