{% liquid
  assign visible_looks = 0
  for block in section.blocks
    if block.settings.image != blank
      assign visible_looks = visible_looks | plus: 1
    endif
  endfor
%}
{% if visible_looks > 0 or request.design_mode %}
  <section class="sh-lookbook sh-container sh-section">
    <div class="sh-lookbook__heading"><div>{% if section.settings.eyebrow != blank %}<p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div>
    <div class="sh-lookbook__grid">
      {% for block in section.blocks %}
        {% if block.settings.image != blank or request.design_mode %}
          <article class="sh-lookbook__look sh-lookbook__look--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}<a class="sh-lookbook__link" href="{{ block.settings.link }}">{% endif %}
              <div class="sh-lookbook__image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 650, 1000, 1400', sizes: '(max-width: 700px) 86vw, 30vw' }}{% else %}{{ 'image' | placeholder_svg_tag: 'sh-placeholder' }}{% endif %}</div>
              <div class="sh-lookbook__caption"><p class="sh-eyebrow">{{ forloop.index | prepend: '0' }}</p><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.link != blank %}<span aria-hidden="true">↗</span>{% endif %}</div>
            {% if block.settings.link != blank %}</a>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}
{% stylesheet %}
  .sh-lookbook{border-top:1px solid var(--line);overflow:hidden}.sh-lookbook__heading{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:54px}.sh-lookbook__heading .sh-eyebrow{margin-bottom:20px}.sh-lookbook__heading h2{font-style:italic;max-width:650px}.sh-lookbook__heading>p{max-width:275px;font-size:12px;line-height:1.75}.sh-lookbook__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}.sh-lookbook__look:nth-child(2){padding-top:90px}.sh-lookbook__look:nth-child(3){padding-top:25px}.sh-lookbook__link{text-decoration:none;display:block}.sh-lookbook__image{aspect-ratio:3/4;overflow:hidden;background:#ddd4c7}.sh-lookbook__look--cool .sh-lookbook__image{background:#d9e1e7}.sh-lookbook__look--warm .sh-lookbook__image{background:#e5cfc0}.sh-lookbook__image img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease}.sh-lookbook__link:hover img{transform:scale(1.035)}.sh-lookbook__caption{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:baseline;margin-top:18px;padding-top:15px;border-top:1px solid var(--line)}.sh-lookbook__caption .sh-eyebrow{font-size:9px;opacity:.65}.sh-lookbook__caption h3{font:italic 25px/1.1 var(--serif);letter-spacing:-.035em}.sh-lookbook__caption>span{font-size:18px}
  @media(max-width:1000px){.sh-lookbook__grid{gap:16px}.sh-lookbook__look:nth-child(2){padding-top:60px}.sh-lookbook__caption{gap:9px}.sh-lookbook__caption h3{font-size:21px}}
  @media(max-width:700px){.sh-lookbook__heading{display:block;margin-bottom:36px}.sh-lookbook__heading>p{margin-top:24px;max-width:330px}.sh-lookbook__grid{grid-template-columns:1fr;gap:34px}.sh-lookbook__look{width:90%;padding-top:0!important}.sh-lookbook__look:nth-child(2){margin-left:auto}.sh-lookbook__caption h3{font-size:25px}.sh-lookbook__image{aspect-ratio:4/5}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.lookbook","max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"t:settings.eyebrow","default":"Le journal des heures"},{"type":"text","id":"heading","label":"t:settings.heading","default":"Une journée. À ta façon."},{"type":"textarea","id":"text","label":"t:settings.text","default":"Des pièces qui passent du café du coin au dernier métro. Compose tes heures."}],"blocks":[{"type":"look","name":"t:sections.look","settings":[{"type":"image_picker","id":"image","label":"t:settings.image"},{"type":"text","id":"title","label":"t:settings.heading","default":"Le matin lent"},{"type":"url","id":"link","label":"t:settings.link"},{"type":"select","id":"tone","label":"t:settings.tone","options":[{"value":"warm","label":"t:settings.warm"},{"value":"cool","label":"t:settings.cool"}],"default":"warm"}]}],"presets":[{"name":"t:sections.lookbook","blocks":[{"type":"look","settings":{"title":"Le matin lent","tone":"warm"}},{"type":"look","settings":{"title":"En mouvement","tone":"cool"}},{"type":"look","settings":{"title":"Après les heures","tone":"warm"}}]}]}
{% endschema %}
