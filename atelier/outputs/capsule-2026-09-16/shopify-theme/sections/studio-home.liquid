<section class="studio-home" aria-labelledby="StudioTitle-{{ section.id }}">
  <div class="studio-intro sh-container"><span>{{ section.settings.eyebrow | escape }}</span><span>{{ 'studio.edition' | t }}</span></div>
  <div class="studio-hero" id="piece">
    <div class="studio-hero__image">
      {% if section.settings.product_image != blank %}
        {{ section.settings.product_image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 650, 900, 1254, 1600', sizes: '(max-width: 800px) 100vw, 56vw' }}
      {% else %}<p class="sh-empty">{{ 'general.image_pending' | t }}</p>{% endif %}
      <span class="studio-caption">{{ 'studio.synthetic' | t }}</span>
    </div>
    <div class="studio-hero__copy">
      <p class="sh-eyebrow">{{ 'studio.category' | t }}</p>
      <h1 id="StudioTitle-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <div class="studio-lead sh-rte">{{ section.settings.intro }}</div>
      <div class="studio-color"><span aria-hidden="true"></span>{{ 'studio.color' | t }}</div>
      <a class="studio-button" href="#porte">{{ 'studio.see_worn' | t }} <span aria-hidden="true">↘</span></a>
      <p class="studio-availability">{{ 'studio.development' | t }}</p>
      <dl class="studio-specs"><div><dt>{{ 'studio.cut_label' | t }}</dt><dd>{{ 'studio.cut' | t }}</dd></div><div><dt>{{ 'studio.print_label' | t }}</dt><dd>{{ 'studio.print' | t }}</dd></div><div><dt>{{ 'studio.support_label' | t }}</dt><dd>AS Colour 5082</dd></div></dl>
    </div>
  </div>
  <div class="studio-strip" aria-hidden="true"><span>CALL ME LATER.</span><span>CALL ME LATER.</span><span>CALL ME LATER.</span></div>
  <div class="studio-editorial" id="porte">
    <div class="studio-editorial__copy"><span class="sh-eyebrow">{{ 'studio.idea_label' | t }}</span><h2>{{ section.settings.story_heading | escape | newline_to_br }}</h2><div class="sh-rte">{{ section.settings.story }}</div><a href="#details">{{ 'studio.explore_details' | t }} <span aria-hidden="true">↗</span></a><span class="studio-index" aria-hidden="true">01 /</span></div>
    <figure class="studio-editorial__image">{% if section.settings.worn_image != blank %}{{ section.settings.worn_image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '400, 650, 900, 1300', sizes: '(max-width: 800px) 100vw, 48vw' }}{% else %}<p class="sh-empty">{{ 'general.image_pending' | t }}</p>{% endif %}<figcaption>{{ 'studio.worn_caption' | t }}</figcaption></figure>
  </div>
  <div class="studio-details sh-container" id="details">
    <div><span class="sh-eyebrow">{{ 'studio.details_label' | t }}</span><h2>{{ 'studio.details_heading' | t }}</h2><p>{{ 'studio.details_intro' | t }}</p></div>
    <div class="studio-accordions">
      <details open><summary>{{ 'studio.fabric_title' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'studio.fabric_text' | t }}</p></details>
      <details><summary>{{ 'studio.graphic_title' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'studio.graphic_text' | t }}</p></details>
      <details><summary>{{ 'studio.size_title' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'studio.size_text' | t }}</p></details>
      <details><summary>{{ 'studio.availability_title' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'studio.availability_text' | t }}</p></details>
    </div>
  </div>
</section>
{% stylesheet %}
  .studio-intro{display:flex;justify-content:space-between;gap:20px;padding-block:18px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid var(--line)}.studio-hero{display:grid;grid-template-columns:minmax(0,56fr) minmax(0,44fr)}.studio-hero__image{position:relative;background:#d8d7d4;align-self:start}.studio-hero__image>img{width:100%;height:auto;aspect-ratio:1;object-fit:contain}.studio-caption{position:absolute;bottom:17px;left:20px;max-width:calc(100% - 40px);font-size:10px;background:var(--cream);padding:6px 10px}.studio-hero__copy{padding:clamp(34px,5.2vw,88px) clamp(24px,4.5vw,72px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.studio-hero__copy>.sh-eyebrow{font-size:10px;color:var(--accent);margin-bottom:24px}.studio-hero h1{font-size:clamp(48px,6.5vw,104px);line-height:.88;letter-spacing:-.065em;text-transform:none;overflow-wrap:anywhere}.studio-lead{margin-top:26px;font-size:14px;max-width:35ch;line-height:1.7}.studio-color{display:flex;align-items:center;gap:10px;font-size:11px;margin-top:28px}.studio-color>span{width:19px;height:19px;border-radius:50%;background:#e5dfcf;outline:1px solid #999;outline-offset:3px}.studio-button{display:flex;align-items:center;justify-content:space-between;gap:30px;width:100%;max-width:400px;padding:17px 20px;background:var(--accent);color:#fff;text-decoration:none;font-size:13px;margin-top:24px;min-height:54px}.studio-button:hover{background:var(--ink)}.studio-availability{font-size:10px;margin-top:12px;opacity:.75}.studio-specs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;width:100%;border-top:1px solid var(--line);padding-top:24px;margin:28px 0 0;font-size:10px}.studio-specs dt{opacity:.65}.studio-specs dd{margin:5px 0 0;font-weight:700}.studio-strip{display:flex;gap:40px;overflow:hidden;white-space:nowrap;background:var(--accent);color:var(--cream);font-size:clamp(35px,7vw,110px);font-weight:900;line-height:1.15;letter-spacing:-.06em;padding:15px 0;user-select:none}.studio-strip>span{flex-shrink:0}.studio-strip>span:nth-child(even){color:var(--butter)}.studio-editorial{display:grid;grid-template-columns:minmax(0,52fr) minmax(0,48fr);background:var(--butter)}.studio-editorial__copy{padding:clamp(38px,6vw,94px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center;position:relative}.studio-editorial h2{font-size:clamp(40px,5.8vw,86px);text-transform:none;line-height:.98;letter-spacing:-.055em;margin-top:30px}.studio-editorial__copy .sh-rte{font-size:14px;max-width:39ch;line-height:1.8;margin-top:28px}.studio-editorial__copy>a{margin-top:30px;font-size:12px}.studio-index{font-size:clamp(64px,10vw,150px);font-weight:900;line-height:1;letter-spacing:-.09em;opacity:.1;margin-top:52px}.studio-editorial__image{position:relative;margin:0;min-width:0;align-self:start;background:#d7d2c6}.studio-editorial__image>img{width:100%;height:auto;aspect-ratio:2/3;object-fit:contain}.studio-editorial__image figcaption{position:absolute;bottom:20px;left:20px;right:20px;background:var(--cream);padding:7px 10px;font-size:10px;width:fit-content;max-width:calc(100% - 40px)}.studio-details{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding-block:90px}.studio-details h2{font-size:clamp(34px,4vw,58px);text-transform:none;margin:20px 0;max-width:12ch;letter-spacing:-.055em}.studio-details>div>p{max-width:37ch;font-size:13px;line-height:1.8}.studio-accordions details{border-top:1px solid var(--line)}.studio-accordions details:last-child{border-bottom:1px solid var(--line)}.studio-accordions summary{display:flex;justify-content:space-between;gap:18px;list-style:none;padding:23px 0;font-size:13px;font-weight:700;min-height:60px}.studio-accordions summary::-webkit-details-marker{display:none}.studio-accordions details[open] summary>span{transform:rotate(45deg)}.studio-accordions details>p{font-size:12px;line-height:1.85;padding:0 20px 24px 0;max-width:55ch}
  @media(min-width:1500px){.studio-hero,.studio-editorial{max-width:1720px;margin-inline:auto}}@media(max-width:1050px){.studio-specs{gap:10px}.studio-hero__copy{padding:30px 26px}.studio-lead{font-size:13px}.studio-index{margin-top:35px}}@media(max-width:800px){.studio-intro{font-size:9px}.studio-hero,.studio-editorial,.studio-details{grid-template-columns:1fr}.studio-hero__copy{padding:32px var(--gutter) 40px}.studio-hero h1{font-size:clamp(60px,14vw,98px)}.studio-hero__copy>.sh-eyebrow{margin-bottom:18px}.studio-lead{max-width:42ch;margin-top:22px}.studio-specs{font-size:11px;max-width:500px}.studio-button{max-width:none}.studio-editorial__copy{padding:44px var(--gutter)}.studio-editorial h2{font-size:clamp(42px,9vw,72px)}.studio-index{display:none}.studio-editorial__image{grid-row:1}.studio-details{padding-block:50px;gap:32px}.studio-details h2{max-width:none}.studio-details>div>p{max-width:45ch}.studio-editorial__image>img{max-height:850px}.studio-strip{gap:28px;font-size:56px}}@media(prefers-reduced-motion:reduce){.studio-strip{scroll-behavior:auto}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.studio","settings":[{"type":"text","id":"eyebrow","label":"t:settings.eyebrow","default":"LE STUDIO / PREMIÈRE ÉTUDE"},{"type":"textarea","id":"heading","label":"t:settings.heading","default":"Call me\nlater."},{"type":"richtext","id":"intro","label":"t:settings.text","default":"<p>Pour les messages auxquels tu as répondu dans ta tête.</p>"},{"type":"image_picker","id":"product_image","label":"t:settings.image"},{"type":"image_picker","id":"worn_image","label":"t:settings.secondary_image"},{"type":"textarea","id":"story_heading","label":"t:settings.heading","default":"J’ai répondu.\nDans ma tête."},{"type":"richtext","id":"story","label":"t:settings.text","default":"<p>Un combiné rouge, un cordon qui s’emmêle et trois mots qu’on connaît bien. Le quotidien, avec un peu plus de couleur.</p>"}],"presets":[{"name":"t:sections.studio"}]}
{% endschema %}
