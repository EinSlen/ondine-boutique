{% liquid
 assign mode = section.settings.mode | default: 'all'
 assign piece = section.settings.piece | default: 1
%}
<div class="ed ed-mode-{{ mode }}" data-capsule data-mode="{{ mode }}">
  <a class="ed-skip" href="#pieces">{{ 'capsule.skip' | t }}</a>
  <div class="ed-announcement">{{ 'capsule.soon' | t }} <span aria-hidden="true">/</span> {{ 'capsule.edition' | t }}</div>
  <header class="ed-header">
    <nav aria-label="{{ 'capsule.nav' | t }}"><a href="{{ routes.root_url }}?view=femme">{{ 'capsule.women' | t }}</a><a href="{{ routes.root_url }}?view=homme">{{ 'capsule.men' | t }}</a><a class="ed-nav-story" href="{{ routes.root_url }}#esprit">{{ 'capsule.looks' | t }}</a></nav>
    <a class="ed-logo" href="{{ routes.root_url }}">{{ 'capsule.wordmark' | t }}<sup>01</sup></a>
    <a class="ed-saved-link" href="#pieces" data-filter-link="saved"><span class="ed-save-word">{{ 'capsule.saved' | t }}</span><span data-saved-count>0</span></a>
  </header>
  <main id="top">
    {% if mode == 'all' %}<section class="ed-hero" aria-labelledby="hero-title">
      {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2200 | image_tag: widths: '600,1000,1500,2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'ed-hero-image' }}{% endif %}
      <div class="ed-hero-shade"></div>
      <div class="ed-hero-content"><p class="ed-label">{{ 'capsule.hero_top' | t }}</p><h1 id="hero-title">{{ 'capsule.hero_one' | t }}<br><em>{{ 'capsule.hero_two' | t }}</em></h1><p class="ed-hero-copy">{{ 'capsule.hero_copy' | t }}</p><a class="ed-button ed-button-sky" href="#pieces">{{ 'capsule.discover' | t }}</a></div>
      <div class="ed-hero-foot"><span>{{ 'capsule.hero_bottom' | t }}</span><a href="#pieces">{{ 'capsule.scroll' | t }}</a></div>
    </section>
    <div class="ed-ribbon" aria-hidden="true"><span>CHOCOLAT & CIEL</span><span>FEMME & HOMME</span><span>LES ANNÉES 2000</span><span>CHOCOLAT & CIEL</span></div>
    {% endif %}
    {% if mode == 'piece' %}
{% liquid
 assign offset = piece | minus: 1
 assign col = offset | modulo: 4
 assign row = offset | divided_by: 4
 assign title_key = 'capsule.product_' | append: piece
 assign desc_key = 'capsule.desc_' | append: piece
 assign title = title_key | t
%}
<section class="ed-product-page" style="--col:{{ col }};--row:{{ row }}">
 <div class="ed-product-photo"><span class="ed-sprite">{{ section.settings.pieces_image | image_url: width: 2200 | image_tag: alt: title, loading: 'eager' }}</span><p>{{ 'boutique.concept_image' | t }}</p></div>
 <div class="ed-product-copy"><a class="ed-breadcrumb" href="{{ routes.root_url }}?view={% if piece < 5 %}femme{% else %}homme{% endif %}">{% if piece < 5 %}{{ 'capsule.women' | t }}{% else %}{{ 'capsule.men' | t }}{% endif %} / 0{{ piece }}</a><h1>{{ title }}</h1><p class="ed-product-lead">{{ desc_key | t }}</p><p class="ed-stock">{{ 'capsule.availability' | t }}</p><p>{{ 'capsule.availability_copy' | t }}</p><a class="ed-button ed-button-dark" href="{{ routes.root_url }}?view=contact">{{ 'boutique.question' | t }}</a>
 <details open><summary>{{ 'capsule.details' | t }}</summary><p>{{ desc_key | t }}</p></details><details><summary>{{ 'boutique.size_title' | t }}</summary><p>{{ 'boutique.size_copy' | t }}</p></details><details><summary>{{ 'boutique.delivery_title' | t }}</summary><p>{{ 'capsule.faq_three_a' | t }}</p></details>
 </div>
</section>
{% endif %}
{% if mode == 'contact' %}
<section class="ed-contact"><p class="ed-label">{{ 'boutique.contact' | t }}</p><h1>{{ 'boutique.contact_title' | t }}</h1><p>{{ 'boutique.contact_copy' | t }}</p>
{% form 'contact' %}
{% if form.posted_successfully? %}<p role="status">{{ 'boutique.sent' | t }}</p>{% endif %}
{{ form.errors | default_errors }}
<label for="ContactName">{{ 'boutique.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}">
<label for="ContactEmail">{{ 'boutique.email' | t }}</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email | escape }}">
<label for="ContactBody">{{ 'boutique.message' | t }}</label><textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><button class="ed-button ed-button-dark" type="submit">{{ 'boutique.send' | t }}</button>
{% endform %}</section>
{% endif %}
    <section class="ed-selection" id="pieces" aria-labelledby="selection-title">
      <div class="ed-section-head"><div><p class="ed-label">{{ 'capsule.concept' | t }} / 01</p><{% if mode == 'women' or mode == 'men' %}h1{% else %}h2{% endif %} id="selection-title">{% if mode == 'women' %}{{ 'capsule.women' | t }}{% elsif mode == 'men' %}{{ 'capsule.men' | t }}{% elsif mode == 'piece' %}{{ 'boutique.related' | t }}{% else %}{{ 'capsule.selection' | t }}{% endif %}</{% if mode == 'women' or mode == 'men' %}h1{% else %}h2{% endif %}></div><p>{{ 'capsule.selection_sub' | t }}</p></div>
      <div class="ed-filterbar"><div class="ed-filters" aria-label="{{ 'capsule.selection' | t }}"><button type="button" data-filter="all" aria-pressed="true">{{ 'capsule.all' | t }}</button><button type="button" data-filter="women" aria-pressed="false">{{ 'capsule.women' | t }}</button><button type="button" data-filter="men" aria-pressed="false">{{ 'capsule.men' | t }}</button><button type="button" data-filter="saved" aria-pressed="false">{{ 'capsule.saved' | t }}</button></div><span class="ed-count" aria-live="polite"><span data-piece-count>8</span> {{ 'capsule.count' | t }}</span></div>
      <p class="ed-empty" data-empty hidden>{{ 'capsule.empty' | t }}</p>
      <div class="ed-grid">
        {% for n in (1..8) %}
          {% liquid
            assign offset = n | minus: 1
            assign col = offset | modulo: 4
            assign row = offset | divided_by: 4
            assign title_key = 'capsule.product_' | append: n
            assign desc_key = 'capsule.desc_' | append: n
            assign title = title_key | t
            assign category = 'women'
            if n > 4
              assign category = 'men'
            endif
            assign category_key = 'capsule.' | append: category
          %}
          <article class="ed-card" data-piece="{{ n }}" data-category="{{ category }}" style="--col:{{ col }};--row:{{ row }}">
            <div class="ed-card-visual"><a href="{{ routes.root_url }}?view=piece-{{ n }}" class="ed-image-button" aria-label="{{ 'capsule.view' | t | escape }} : {{ title | escape }}"><span class="ed-sprite">{% if section.settings.pieces_image != blank %}{{ section.settings.pieces_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: title, class: 'ed-sprite-image' }}{% endif %}</span><span class="ed-quick">{{ 'capsule.view' | t }}</span></a><button type="button" class="ed-heart" data-save="{{ n }}" aria-pressed="false" aria-label="{{ 'capsule.save' | t | escape }} : {{ title | escape }}" data-save-label="{{ 'capsule.save' | t | escape }}" data-remove-label="{{ 'capsule.remove' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z"/></svg></button></div>
            <div class="ed-card-meta"><div><p>{{ category_key | t }} <span>— 0{{ n }}</span></p><h3><a href="{{ routes.root_url }}?view=piece-{{ n }}">{{ title }}</a></h3></div><span class="ed-swatch ed-swatch-{{ n }}" aria-hidden="true"></span></div>
            <template data-detail="{{ n }}"><div class="ed-modal-image" style="--col:{{ col }};--row:{{ row }}"><span class="ed-sprite">{% if section.settings.pieces_image != blank %}{{ section.settings.pieces_image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: title, class: 'ed-sprite-image' }}{% endif %}</span></div><div class="ed-modal-copy"><p class="ed-label">{{ category_key | t }} / 0{{ n }}</p><h2 id="detail-title">{{ title }}</h2><h3>{{ 'capsule.details' | t }}</h3><p>{{ desc_key | t }}</p><div class="ed-modal-note"><strong>{{ 'capsule.availability' | t }}</strong><p>{{ 'capsule.availability_copy' | t }}</p></div><button class="ed-button ed-button-dark" type="button" data-close>{{ 'capsule.back' | t }}</button></div></template>
          </article>
        {% endfor %}
      </div>
      <p class="ed-saved-note" data-saved-note hidden>{{ 'capsule.saved_notice' | t }}</p>
    </section>
    {% if mode == 'all' %}<section class="ed-story" id="esprit" aria-labelledby="story-title"><div class="ed-story-art" aria-hidden="true"><div class="ed-story-card ed-story-first" style="--col:0;--row:0"><span class="ed-sprite">{% if section.settings.pieces_image != blank %}{{ section.settings.pieces_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: '', class: 'ed-sprite-image' }}{% endif %}</span><span>01 / FEMME</span></div><div class="ed-story-card ed-story-second" style="--col:0;--row:1"><span class="ed-sprite">{% if section.settings.pieces_image != blank %}{{ section.settings.pieces_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: '', class: 'ed-sprite-image' }}{% endif %}</span><span>05 / HOMME</span></div></div><div class="ed-story-copy"><p class="ed-label">{{ 'capsule.story_tag' | t }}</p><h2 id="story-title">{{ 'capsule.story_one' | t }}<br><em>{{ 'capsule.story_two' | t }}</em></h2><p>{{ 'capsule.story_copy' | t }}</p><div class="ed-story-links"><a href="{{ routes.root_url }}?view=femme">{{ 'capsule.explore_women' | t }}</a><a href="{{ routes.root_url }}?view=homme">{{ 'capsule.explore_men' | t }}</a></div></div></section>
    <section class="ed-palette" aria-label="{{ 'capsule.palette' | t }}"><p class="ed-label">{{ 'capsule.palette' | t }}</p><div><span><i class="ed-color-chocolate"></i>{{ 'capsule.chocolate' | t }}</span><span><i class="ed-color-sky"></i>{{ 'capsule.sky' | t }}</span><span><i class="ed-color-burgundy"></i>{{ 'capsule.burgundy' | t }}</span><span><i class="ed-color-cream"></i>{{ 'capsule.cream' | t }}</span></div></section>
    <section class="ed-faq"><h2>{{ 'capsule.faq' | t }}</h2><div><details><summary>{{ 'capsule.faq_one' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'capsule.faq_one_a' | t }}</p></details><details><summary>{{ 'capsule.faq_two' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'capsule.faq_two_a' | t }}</p></details><details><summary>{{ 'capsule.faq_three' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'capsule.faq_three_a' | t }}</p></details></div></section>
{% endif %}
  </main>
  <footer class="ed-footer"><div class="ed-footer-top"><p>{{ 'capsule.footer_line' | t }}</p><a href="#top">{{ 'capsule.top' | t }}</a></div><div class="ed-footer-logo" aria-hidden="true">{{ 'capsule.wordmark' | t }}<sup>01</sup></div><div class="ed-footer-bottom"><span>{{ 'capsule.footer_note' | t }}</span><a href="{{ routes.root_url }}?view=contact">{{ 'boutique.contact' | t }}</a></div></footer>
  <dialog class="ed-dialog" aria-labelledby="detail-title"><button type="button" class="ed-dialog-close" data-close aria-label="{{ 'capsule.close' | t }}">×</button><div data-dialog-content></div></dialog>
</div>

{% stylesheet %}

