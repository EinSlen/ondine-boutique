{% javascript %}

function initCapsule(root){
 if(root.dataset.ready)return;
 root.dataset.ready='true';
 let saved=new Set();
 try{const previous=JSON.parse(localStorage.getItem('capsule-favourites-v2')||'[]');if(Array.isArray(previous))saved=new Set(previous.filter(v=>/^[1-8]$/.test(v)));}catch{}
 let active=['women','men'].includes(root.dataset.mode)?root.dataset.mode:'all';let opener=null;
 const cards=[...root.querySelectorAll('[data-piece]')];
 const dialog=root.querySelector('dialog');
 const content=root.querySelector('[data-dialog-content]');
 function update(){
  let count=0;
  cards.forEach(card=>{const visible=active==='all'||(active==='saved'?saved.has(card.dataset.piece):card.dataset.category===active);card.hidden=!visible;if(visible)count++;const heart=card.querySelector('[data-save]');const selected=saved.has(card.dataset.piece);heart.setAttribute('aria-pressed',String(selected));heart.setAttribute('aria-label',(selected?heart.dataset.removeLabel:heart.dataset.saveLabel)+' : '+card.querySelector('h3').textContent.trim());});
  root.querySelectorAll('[data-filter]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===active)));
  root.querySelector('[data-piece-count]').textContent=String(count);
  root.querySelector('[data-saved-count]').textContent=String(saved.size);
  root.querySelector('[data-empty]').hidden=count!==0;
  root.querySelector('[data-saved-note]').hidden=active!=='saved';
 }
 function close(){dialog.close();}
 root.addEventListener('click',event=>{
  const target=event.target.closest('button,a');if(!target)return;
  if(target.matches('[data-filter],[data-filter-link]')){if(root.dataset.mode==='contact')root.querySelector('.ed-selection').style.display='block';active=target.dataset.filter||target.dataset.filterLink;const change=()=>update();if(document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.startViewTransition(change);else change();}
  if(target.matches('[data-save]')){const id=target.dataset.save;if(saved.has(id))saved.delete(id);else saved.add(id);try{localStorage.setItem('capsule-favourites-v2',JSON.stringify([...saved]));}catch{}update();}
  if(target.matches('[data-open]')){opener=target;const template=root.querySelector('[data-detail="'+target.dataset.open+'"]');content.replaceChildren(template.content.cloneNode(true));dialog.showModal();document.body.classList.add('ed-modal-open');}
  if(target.matches('[data-close]'))close();
 });
 dialog.addEventListener('click',event=>{if(event.target===dialog){const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)close();}});
 dialog.addEventListener('close',()=>{document.body.classList.remove('ed-modal-open');content.replaceChildren();if(opener)opener.focus();});
 update();
}
document.querySelectorAll('[data-capsule]').forEach(initCapsule);
document.addEventListener('shopify:section:load',event=>{event.target.querySelectorAll('[data-capsule]').forEach(initCapsule);});

{% endjavascript %}
