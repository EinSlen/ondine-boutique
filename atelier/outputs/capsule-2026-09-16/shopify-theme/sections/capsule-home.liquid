:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,#21150dda 0%,#21150d80 34%,transparent 74%),linear-gradient(0deg,#20120985,transparent 25%)}.ed-hero-content{padding:50px 6vw 100px;max-width:800px}.ed-label{font-size:10px;text-transform:uppercase;letter-spacing:.16em;line-height:1.5;margin:0 0 24px}.ed h1,.ed h2,.ed h3{text-transform:none}.ed h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(60px,7.5vw,114px);font-weight:400;line-height:.98;letter-spacing:-.065em;margin:0 0 28px}.ed h1 em{font-weight:400}.ed-hero-copy{max-width:260px;font-size:13px;line-height:1.7;margin-bottom:30px}.ed-button{display:inline-flex;justify-content:space-between;align-items:center;gap:45px;padding:19px 23px;min-height:52px;border:0;font-size:11px;letter-spacing:.025em;transition:background .2s,transform .2s}.ed-button:hover{transform:translateY(-2px)}.ed-button-sky{background:var(--ed-blue);color:var(--ed-ink)!important}.ed-button-dark{background:var(--ed-ink);color:var(--ed-paper)!important}.ed-button span{font-size:18px}.ed-hero-foot{position:absolute;bottom:29px;left:4vw;right:4vw;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.025em}.ed-ribbon{background:var(--ed-blue);padding:17px 3vw;display:flex;justify-content:space-around;align-items:center;gap:28px;overflow:hidden;white-space:nowrap;font-size:10px;letter-spacing:.13em}.ed-ribbon i{font-size:21px;font-style:normal}.ed-selection{padding:85px 4vw 75px;max-width:1600px;margin:auto}.ed-section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:36px}.ed-section-head .ed-label{margin-bottom:15px}.ed h2{font-family:Georgia,serif;font-weight:400;letter-spacing:-.055em}.ed-section-head h2{font-size:60px;line-height:1;margin:0}.ed-section-head h2 span{font-size:35px;margin-left:15px;vertical-align:top}.ed-section-head>p{font-size:12px;margin:0 0 5px;max-width:240px;line-height:1.6}.ed-filterbar{display:flex;justify-content:space-between;align-it