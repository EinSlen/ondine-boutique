<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_cream }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% if settings.showcase_mode %}{{ 'studio.page_title' | t }}{% else %}{{ page_title | escape }}{% unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}{% endif %}</title>
    {% if settings.showcase_mode %}<meta name="robots" content="noindex,nofollow">{% endif %}
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {% render 'theme-base' %}
    {% style %}:root{--cream:{{ settings.color_cream }};--ink:{{ settings.color_ink }};--accent:{{ settings.color_accent }};--butter:{{ settings.color_butter }};}{% endstyle %}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">{% if settings.showcase_mode and template.name != 'index' %}{% if template.name == 'product' and product.tags contains 'atelier-cml-20260908' %}{{ content_for_layout }}{% else %}{% render 'studio-gate' %}{% endif %}{% else %}{{ content_for_layout }}{% endif %}</main>
    {% sections 'footer-group' %}
  </body>
</html>
