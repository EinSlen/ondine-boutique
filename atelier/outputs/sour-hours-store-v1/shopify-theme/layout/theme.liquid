<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>{% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'sour-hours.css' | asset_url | stylesheet_tag }}<script src="{{ 'sour-hours.js' | asset_url }}" defer="defer"></script></head><body class="template-{{ request.page_type | handle }}"><a class="skip" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>{% sections 'header-group' %}<main id="MainContent" role="main">{{ content_for_layout }}</main>{% sections 'footer-group' %}</body></html>
