<section class="hero">{% if section.settings.hero != blank %}{{ section.settings.hero | image_url: width: 2400 | image_tag: class: 'hero-image', loading: 'eager', widths: '800,1200,1800,2400', alt: section.settings.hero.alt }}{% else %}<img src="{{ 'campaign-sour-hours.png' | asset_url }}" width="1536" height="1024" alt="SOUR HOURS campaign outside a diner">{% endif %}<div class="hero-overlay"></div><div class="hero-copy"><p class="micro">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.title | newline_to_br }}</h1><a class="btn light" href="#shop">{{ section.settings.button | escape }} <b>↘</b></a></div><p class="hero-side">Good clothes for bad ideas.<br>Made after midnight.</p></section><div class="ticker">SOUR HOURS ✦ DROP 01 ✦ STAY OUT LATE ✦ BOXIER / HEAVIER / BETTER</div>
<section class="shop" id="shop"><div class="section-title"><div><p class="micro">01 / Full capsule</p><h2>TWELVE WAYS<br>TO STAY OUT.</h2></div><p>Jersey, tee, knit, denim, track pants and accessories: a full wardrobe, not a row of hoodies.</p></div><div class="product-grid">{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}{% for product in section.settings.collection.products limit: 12 %}{% render 'sour-product-card', product: product, card_index: forloop.index %}{% endfor %}{% else %}{% assign names = 'Night Shift Racing Jersey|Night Work Denim|Broken Halo Longsleeve|Pit Lane Track Pants|Stray Dogs Tee|Midnight Balaclava|Broken Halo Earrings|Night Shift Scarf|Sour Cherry Hoodie|After Midnight Knit|Lucky Star Zip|Raw Club Hoodie' | split: '|' %}{% assign prices = '69 €|89 €|59 €|79 €|45 €|39 €|49 €|39 €|89 €|89 €|95 €|89 €' | split: '|' %}{% assign images = 'night-shift-racing-jersey.png|night-work-denim-jeans.png|broken-halo-longsleeve.png|pit-lane-track-pants.png|stray-dogs-tee.png|midnight-balaclava.png|broken-halo-earrings.png|night-shift-scarf.png|sour-cherry-hoodie-chocolate.png|after-midnight-knit.png|lucky-star-zip.png|raw-club-hoodie.png' | split: '|' %}{% for name in names %}<article class="product-card theme-card{% if forloop.index == 1 or forloop.index == 11 %} large{% elsif forloop.index == 2 or forloop.index == 12 %} raw{% endif %}"><div class="visual"><img src="{{ images[forloop.index0] | asset_url }}" width="1536" height="1024" loading="lazy" alt="{{ name }}"></div><div class="meta"><h3>{{ name }}</h3><strong>{{ prices[forloop.index0] }}</strong></div></article>{% endfor %}{% endif %}</div></section>
<section class="world" id="world"><div class="world-copy"><p class="micro">02 / The world</p><h2>ONE DROP.<br><em>EVERY MOOD.</em></h2><p>Twelve pieces across seven product families, linked by the same dark palette, club graphics and tactile finishes.</p></div><div class="symbols" aria-hidden="true"><div>★</div><div>↝</div><div>☾</div><div>17</div></div></section><section class="campaign"><div class="campaign-image"><img src="{{ 'campaign-sour-hours.png' | asset_url }}" width="1536" height="1024" loading="lazy" alt="SOUR HOURS campaign at night"></div><div class="campaign-copy"><p class="micro">Outside / 02:13 AM</p><blockquote>“Good clothes<br>for bad ideas.”</blockquote><p>Drop 01<br>France / EU</p></div></section><section class="details"><div class="section-title dark"><div><p class="micro">03 / Product proof</p><h2>THE DETAIL<br>DOES THE WORK.</h2></div><p>Final specifications must be confirmed after physical sampling.</p></div><div class="detail-grid"><article><b>12</b><h3>Pieces</h3><p>From jersey to earrings.</p></article><article><b>07</b><h3>Product families</h3><p>Apparel, bottoms and accessories.</p></article><article><b>06</b><h3>Finishes</h3><p>Chenille, appliqué, embroidery, print, jacquard and metal.</p></article><article><b>01</b><h3>Cherry piece</h3><p>One hero, not a uniform.</p></article></div></section>
{% schema %}{"name":"Sour Hours home","settings":[{"type":"image_picker","id":"hero","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Open late / Drop 01"},{"type":"textarea","id":"title","label":"Title","default":"THE NIGHT\nIS STILL\nYOUNG."},{"type":"text","id":"button","label":"Button","default":"Shop the drop"},{"type":"collection","id":"collection","label":"Drop collection"}]}{% endschema %}
