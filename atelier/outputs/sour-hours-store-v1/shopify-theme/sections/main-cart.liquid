<section class="theme-cart"><p class="micro">Your selection</p><h1 class="theme-page-title">BAG / {{ cart.item_count }}</h1>{% if cart.item_count > 0 %}{% form 'cart', cart %}<table><thead><tr><th>Product</th><th>Size</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<br>{{ item.product.title }}</a></td><td>{{ item.variant.title }}</td><td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><p class="theme-cart-total">{{ cart.total_price | money }}</p><button class="btn" type="submit" name="update">Update</button><button class="btn dark-btn" type="submit" name="checkout">Checkout</button>{% endform %}{% else %}<p>Nothing here yet.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Shop the drop</a>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
