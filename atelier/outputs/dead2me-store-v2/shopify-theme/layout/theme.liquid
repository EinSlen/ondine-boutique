<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  {{ 'd2m-v2.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'd2m-v2.js' | asset_url }}" defer></script>
</head>
<body>
  <a class="skip" href="#MainContent">Aller au contenu</a>
  {% sections 'header-group' %}
  <main id="MainContent" role="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
