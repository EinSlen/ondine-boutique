<section class="d2m-cart-page"><h1>TON PANIER</h1>{% if cart.item_count == 0 %}<p>Ton panier est vide.</p><a class="d2m-button" href="{{ routes.all_products_collection_url }}">VOIR LE DROP</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="d2m-cart-line">{% if item.image %}{{ item.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<div><a href="{{ item.url }}"><b>{{ item.product.title }}</b></a><p>{{ item.variant.title }}</p><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><b>{{ item.final_line_price | money }}</b></div>{% endfor %}<div class="d2m-cart-total"><span>TOTAL</span><b>{{ cart.total_price | money }}</b></div><button name="checkout" type="submit">PASSER AU PAIEMENT</button></form>{% endif %}</section>{% schema %}{"name":"Panier D2M","settings":[]}{% endschema %}
