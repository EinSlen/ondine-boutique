<section class="d2m-hero">
  <div class="d2m-hero-copy"><span class="d2m-eyebrow">{{ section.settings.kicker }}</span><h1>{{ section.settings.heading | newline_to_br }}</h1><p>{{ section.settings.text }}</p><a class="d2m-cta" href="#drop">VOIR LE DROP <span>↘</span></a></div>
  <div class="d2m-hero-product"><div class="d2m-mock d2m-mock-hero"><img src="{{ 'raw-hoodie-base.png' | asset_url }}" width="1536" height="1024" alt="Concept RAW 01 hoodie, face et dos"><span class="d2m-mark d2m-mark-front">D2M</span><span class="d2m-mark d2m-mark-back">DEAD2ME</span></div><div class="d2m-hero-meta"><span>RAW/01 HOOD</span><span>400 GSM CIBLE</span><span>99 EUR</span></div></div>
</section>
<div class="d2m-ticker"><div>BOXY FIT · ORGANIC COTTON · MADE IN PORTUGAL · RAW EDGE APPLIQUÉ · BOXY FIT · ORGANIC COTTON · MADE IN PORTUGAL · RAW EDGE APPLIQUÉ ·</div></div>
<section class="d2m-drop" id="drop"><div class="d2m-section-title"><span>01</span><h2>DROP 001</h2><p>Trois silhouettes. Pas trente références.</p></div>
  {% assign featured = section.settings.collection %}
  {% if featured != blank and featured.products_count > 0 %}<div class="d2m-grid">{% for product in featured.products limit: 3 %}{% render 'd2m-product-card', product: product %}{% endfor %}</div>
  {% else %}<div class="d2m-grid">
    <article class="d2m-card"><a class="d2m-product-visual" href="{{ routes.all_products_collection_url }}"><span class="d2m-flag">HERO PIECE</span><span class="d2m-mock"><img src="{{ 'raw-hoodie-base.png' | asset_url }}" width="1536" height="1024" alt="RAW 01 Hoodie concept"><span class="d2m-mark d2m-mark-front">D2M</span><span class="d2m-mark d2m-mark-back">DEAD2ME</span></span></a><div class="d2m-info"><div><h3>RAW/01 HOODIE</h3><p>Washed black · applique + broderie</p></div><b>99 €</b></div></article>
    <article class="d2m-card"><a class="d2m-product-visual" href="{{ routes.all_products_collection_url }}"><span class="d2m-mock"><img src="{{ 'sign-tee-base.png' | asset_url }}" width="1536" height="1024" alt="SIGN 02 Tee concept"><span class="d2m-mark d2m-tee-front">D2M</span><span class="d2m-mark d2m-tee-back">DEAD2ME</span></span></a><div class="d2m-info"><div><h3>SIGN/02 BOXY TEE</h3><p>Vintage bone · 240 GSM · broderie</p></div><b>59 €</b></div></article>
    <article class="d2m-card"><a class="d2m-product-visual" href="{{ routes.all_products_collection_url }}"><span class="d2m-mock"><img src="{{ 'night-ls-base.png' | asset_url }}" width="1536" height="1024" alt="NIGHT 03 Long Sleeve concept"><span class="d2m-mark d2m-ls-front">DEAD2ME</span><span class="d2m-mark d2m-ls-back">D2M</span></span></a><div class="d2m-info"><div><h3>NIGHT/03 LONG SLEEVE</h3><p>Vintage oxblood · 240 GSM · print relief</p></div><b>69 €</b></div></article>
  </div>{% endif %}
</section>
<section class="d2m-proof"><div class="d2m-proof-title"><span class="d2m-eyebrow">NOT MERCH. A GARMENT.</span><h2>La coupe avant le graphisme.</h2></div><div class="d2m-proof-grid"><div><b>01</b><h3>BOXY, PAS JUSTE LARGE</h3><p>Corps plus court, poitrine large et épaules descendues.</p></div><div><b>02</b><h3>240–400 GSM</h3><p>Jersey lourd et molleton dense. Poids final confirmé après échantillon.</p></div><div><b>03</b><h3>MARQUAGE TACTILE</h3><p>Petite broderie devant, application à bords bruts au dos.</p></div></div></section>
<section class="d2m-about"><div class="d2m-index">DEAD2ME®<br>FR / EU<br>DROP 001</div><div><h2>Built from what remains.</h2><p>DEAD2ME travaille autour des traces que les gens laissent : une marque, une couture, une couleur passée. RAW SIGNAL est la première capsule — sobre de loin, précise de près.</p></div></section>
{% schema %}{"name":"D2M Home","settings":[{"type":"text","id":"kicker","label":"Sur-titre","default":"DEAD2ME / RAW SIGNAL / 2026"},{"type":"textarea","id":"heading","label":"Titre","default":"HEAVY\nTHINGS\nSTAY."},{"type":"textarea","id":"text","label":"Texte","default":"Des coupes boxy lourdes. Des marquages tactiles. Aucun bruit inutile."},{"type":"collection","id":"collection","label":"Collection Drop 001"}],"presets":[{"name":"D2M Home"}]}{% endschema %}
