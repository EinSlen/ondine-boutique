<section class="d2m-collection"><div class="d2m-section-title"><span>01</span><h1>{{ collection.title }}</h1><p>{{ collection.products_count }} pièces</p></div>{% if collection.description != blank %}<div class="d2m-rte">{{ collection.description }}</div>{% endif %}<div class="d2m-grid">{% for product in collection.products %}{% render 'd2m-product-card', product: product %}{% else %}<p>Aucun produit dans cette collection.</p>{% endfor %}</div></section>{% schema %}{"name":"Collection D2M","settings":[]}{% endschema %}
