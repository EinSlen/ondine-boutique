<section class="newsletter"><div><p class="micro">Stay in the loop</p><h2>{{ section.settings.heading | escape }}</h2></div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="FooterEmail-{{ section.id }}">Email</label><div><input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="you@email.com" required><button type="submit">Join the list ↗</button></div>{% endform %}</section><footer><a class="footer-logo" href="{{ routes.root_url }}">{{ shop.name | default: 'SOUR HOURS' }}</a><div><a href="{{ routes.all_products_collection_url }}">Shop</a>{% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Returns</a>{% endif %}</div><p>© {{ 'now' | date: '%Y' }} {{ shop.name }}<br>France / EU</p></footer>
{% schema %}{"name":"Sour Hours footer","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"DON'T GO\nHOME YET."}]}{% endschema %}
