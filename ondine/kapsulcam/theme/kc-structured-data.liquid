{%- comment -%} Shopify product JSON-LD plus what Google merchant listings ask for: return policy and shipping on each offer, description on each variant. Must match the shipping and return pages. rating: true adds the Judge.me average, only where kc-rating shows it. {%- endcomment -%}
{%- assign kc_countries = 'FR,BE,LU' | split: ',' -%}
{%- capture kc_offer -%}"@type":"Offer","hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":["FR","BE","LU"],"returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow","merchantReturnDays":30,"returnMethod":"https://schema.org/ReturnByMail","returnFees":"https://schema.org/ReturnFeesCustomerResponsibility"},"shippingDetails":[{%- for c in kc_countries -%}{"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":0,"currency":"EUR"},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"{{ c }}"},"deliveryTime":{"@type":"ShippingDeliveryTime","handlingTime":{"@type":"QuantitativeValue","minValue":1,"maxValue":3,"unitCode":"DAY"},"transitTime":{"@type":"QuantitativeValue","minValue":9,"maxValue":15,"unitCode":"DAY"}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],{%- endcapture -%}
{%- assign kc_description = product.metafields.global.description_tag | default: product.description | strip_html | strip_newlines | truncate: 300 -%}
{%- capture kc_variant -%}#variant","@type":"Product","description":{{ kc_description | json }},{%- endcapture -%}
{%- capture kc_group -%}"@type":"ProductGroup",{%- if rating and product.metafields.reviews.rating_count.value > 0 -%}"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ product.metafields.reviews.rating.value.rating | json }},"reviewCount":{{ product.metafields.reviews.rating_count.value }},"bestRating":5,"worstRating":1},{%- endif -%}{%- endcapture -%}
{%- capture kc_ld -%}{{ product | structured_data }}{%- endcapture -%}
{{ kc_ld | replace: '"@type":"Offer",', kc_offer | replace: '#variant","@type":"Product",', kc_variant | replace: '"@type":"ProductGroup",', kc_group }}
