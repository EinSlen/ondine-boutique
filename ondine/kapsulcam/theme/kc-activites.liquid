{%- comment -%} "Moments" grid, Loop-like: rounded looping video cards with a caption row underneath. {%- endcomment -%}
<style>
  .kc-mo{max-width:1320px;margin:0 auto;padding:0 24px;letter-spacing:0;color:#111}
  .kc-mo h2{font-size:clamp(30px,4vw,48px);font-weight:500;letter-spacing:-1.2px;line-height:1.05;margin:0 0 28px}
  .kc-mo-g{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .kc-mo-c{display:block;text-decoration:none;color:inherit}
  .kc-mo-m{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:3/4;background:#f3f3f1}
  .kc-mo-m video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .kc-mo-cap{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:12px 2px 0;font-size:14.5px}
  .kc-mo-cap span{color:#6b6b6b;font-size:13px;display:block}
  @media(max-width:749px){.kc-mo-g{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;margin:0 -24px;padding:0 24px 6px;scroll-padding-inline:24px}.kc-mo-c{flex:0 0 70%;scroll-snap-align:start}}
</style>
<section class="kc-mo">
  <h2>Partout où la vie<br>vous emmène</h2>
  <div class="kc-mo-g">
    {%- assign acts = 'mer|Mer et piscine|Caisson étanche 30 m;velo|Vélo et VTT|Support guidon;neige|Ski et snow|Clip sur la veste;moto|Moto|Sur le casque' | split: ';' -%}
    {%- for a in acts -%}
      {%- assign p = a | split: '|' -%}
      <a class="kc-mo-c" href="{{ routes.root_url }}products/kapsulcam-4k">
        <div class="kc-mo-m"><video muted loop playsinline preload="none" poster="{{ 'kc-tile-' | append: p[0] | append: '.jpg' | asset_url }}" data-src="{{ 'kc-tile-' | append: p[0] | append: '.mp4' | asset_url }}"></video></div>
        <div class="kc-mo-cap"><div>{{ p[1] }}<span>{{ p[2] }}</span></div><span aria-hidden="true">&rarr;</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>
<script>
  (() => {
    const vids = document.currentScript.previousElementSibling.querySelectorAll('video');
    const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target; if (e.isIntersecting) { if (!v.src) v.src = v.dataset.src; v.play().catch(() => {}); } else v.pause(); }), { threshold: 0.2 });
    vids.forEach((v) => io.observe(v));
  })();
</script>
