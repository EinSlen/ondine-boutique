<section class="sh-password">
  <p class="sh-eyebrow">{{ shop.name | escape }}</p>
  <h1>{{ 'password.title' | t }}</h1>
  {% if shop.password_message != blank %}<div class="sh-rte">{{ shop.password_message }}</div>{% endif %}
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <label for="StorePassword">{{ 'password.label' | t }}</label>
    <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
    <button type="submit" class="sh-button">{{ 'password.submit' | t }}</button>
  {% endform %}
</section>
{% stylesheet %}
  .sh-password{max-width:680px;margin:0 auto;padding:15vh 24px}.sh-password h1{font-size:clamp(38px,7vw,68px);line-height:1.05;margin:25px 0 35px}.sh-password form{display:grid;gap:12px;margin-top:35px}.sh-password input{min-height:48px;padding:12px;background:white;border:1px solid #aaa}.sh-password label{font-size:13px}.sh-password .sh-rte{line-height:1.6}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.password","settings":[]}
{% endschema %}
