<article class="d2m-card"><a class="d2m-product-visual" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1000,1200', alt: product.title }}{% else %}<span class="d2m-placeholder">{{ product.title }}</span>{% endif %}</a><div class="d2m-info"><div><h3>{{ product.title }}</h3><p>{{ product.type }}</p></div><b>{{ product.price | money }}</b></div></article>
