<section class="sh-catalog sh-container sh-section">
  <div class="sh-catalog__heading"><div>{% if section.settings.eyebrow != blank %}<p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} ↗</a>{% endif %}</div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="sh-grid">{% for product in section.settings.collection.products limit: section.settings.count %}{% render 'product-card', product: product %}{% endfor %}</div>
  {% else %}<div class="sh-empty"><p>{{ 'general.collection_empty' | t }}</p>{% if request.design_mode %}<p class="sh-note">{{ 'general.editor_collection' | t }}</p>{% endif %}</div>{% endif %}
</section>
{% stylesheet %}
  .sh-catalog__heading{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:40px}.sh-catalog__heading .sh-eyebrow{margin-bottom:16px}.sh-catalog__heading>a{font-size:12px;white-space:nowrap}.sh-catalog__heading h2{max-width:800px}
  @media(max-width:600px){.sh-catalog__heading{align-items:start}.sh-catalog__heading h2{font-size:40px}.sh-catalog__heading>a{font-size:10px;margin-top:7px}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.catalog","settings":[{"type":"text","id":"eyebrow","label":"t:settings.eyebrow","default":"Le vestiaire"},{"type":"text","id":"heading","label":"t:settings.heading","default":"À porter à ta façon."},{"type":"collection","id":"collection","label":"t:settings.collection"},{"type":"range","id":"count","label":"t:settings.count","min":4,"max":16,"step":4,"default":8}],"presets":[{"name":"t:sections.catalog"}]}
{% endschema %}
