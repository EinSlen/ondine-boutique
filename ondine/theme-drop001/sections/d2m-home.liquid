{% assign logo = collections['logo-essentials'] %}
{% assign graphics = collections['graphic-pieces'] %}
{% assign bottoms = collections['bottoms'] %}
<style>
.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none!important}body{margin:0;background:#fff;color:#0a0a0a;font-family:Arial,Helvetica,sans-serif}.d2m *{box-sizing:border-box}.d2m a{color:inherit;text-decoration:none}.d2m-top{background:#741019;color:#fff;text-align:center;padding:7px 14px;font-size:11px;font-weight:800;letter-spacing:.08em}.d2m-nav{height:72px;background:#050505;color:#fff;display:grid;grid-template-columns:180px 1fr 180px;align-items:center;padding:0 4.5vw;border-bottom:1px solid #242424}.d2m-logo img{height:43px;width:auto;filter:brightness(0) invert(1)}.d2m-menu{display:flex;justify-content:center;gap:42px;font-size:13px;font-weight:800}.d2m-menu a:nth-child(2){color:#8e1822}.d2m-tools{text-align:right;font-size:12px}.d2m-hero{min-height:330px;background:radial-gradient(circle at 70% 45%,#292929 0,#111 30%,#050505 66%);position:relative;overflow:hidden;color:#fff;padding:45px 7vw;display:flex;align-items:center}.d2m-hero:after{content:'D2M';position:absolute;right:6vw;top:22px;font-size:190px;font-weight:1000;color:#6c1119;opacity:.38;transform:rotate(-5deg);letter-spacing:-.08em}.d2m-hero h1{font-size:62px;line-height:.84;margin:0;font-weight:1000;letter-spacing:-.04em;position:relative;z-index:2}.d2m-hero h1 span{color:#941e28}.d2m-hero p{font-size:16px;font-weight:800;margin:18px 0}.d2m-btn{display:inline-block;border:1px solid #fff;padding:12px 22px;font-size:12px;font-weight:900;letter-spacing:.04em}.d2m-wrap{padding:0 3vw 38px}.d2m-section{padding-top:28px}.d2m-section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.d2m-section h2{font-size:14px;margin:0;font-weight:1000}.d2m-view{font-size:10px;font-weight:900}.d2m-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.d2m-grid.five{grid-template-columns:repeat(5,minmax(0,1fr))}.d2m-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.d2m-card img{width:100%;aspect-ratio:1/1.08;object-fit:cover;background:#f2f2f2;display:block}.d2m-card h3{font-size:12px;margin:10px 0 4px;font-weight:900}.d2m-card .price{font-size:12px}.d2m-card .sizes{font-size:10px;margin-top:4px}.d2m-row{display:grid;grid-template-columns:1.25fr .75fr;gap:22px;align-items:start}.d2m-looks{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.d2m-look{background:#171717;color:#fff;min-height:210px;padding:16px;position:relative;overflow:hidden}.d2m-look:after{content:'D2M';position:absolute;right:-5px;bottom:-25px;font-size:92px;font-weight:1000;color:#7d151d;opacity:.45}.d2m-look strong{font-size:12px}.d2m-look p{font-size:11px;line-height:1.5;position:relative;z-index:2}.d2m-benefits{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #ddd;margin-top:25px}.d2m-benefit{padding:22px;border-right:1px solid #ddd;font-size:11px}.d2m-benefit:last-child{border-right:0}.d2m-benefit b{display:block;margin-bottom:5px}.d2m-footer{background:#050505;color:#fff;padding:28px 4vw;display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:50px}.d2m-footer img{height:50px;filter:brightness(0) invert(1)}.d2m-footer p,.d2m-footer a{font-size:11px;line-height:1.65}.d2m-news input{width:70%;background:#050505;border:1px solid #333;color:#fff;padding:13px}.d2m-news button{padding:13px 20px;background:#8d1822;color:#fff;border:0;font-weight:900}.d2m-links{display:grid;grid-template-columns:repeat(2,1fr)}@media(max-width:900px){.d2m-nav{grid-template-columns:120px 1fr}.d2m-menu{display:none}.d2m-tools{display:block}.d2m-logo img{height:36px}.d2m-hero{min-height:290px;padding:38px 7vw}.d2m-hero h1{font-size:46px}.d2m-hero:after{font-size:120px;right:-10px;top:70px}.d2m-grid,.d2m-grid.five{grid-template-columns:repeat(2,1fr)}.d2m-grid.three{grid-template-columns:repeat(2,1fr)}.d2m-row{grid-template-columns:1fr}.d2m-looks{grid-template-columns:1fr}.d2m-benefits{grid-template-columns:1fr 1fr}.d2m-benefit{border-bottom:1px solid #ddd}.d2m-footer{grid-template-columns:1fr}.d2m-news input{width:65%}}
</style>
